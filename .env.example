# === PostgreSQL ===
# 호스트 포트: dev=5434, test=5435 (firehub 5432/5433과 분리)
POSTGRES_DB=workplace
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-to-a-secure-password

# === workplace-api (Spring Boot) ===
# JWT 서명 키 (Base64 인코딩, 256비트 이상)
JWT_SECRET=
# 암호화 마스터 키 (Base64 인코딩)
ENCRYPTION_MASTER_KEY=
# AI Agent 내부 통신 토큰 — 기본값 없음, 미설정 시 앱 기동 실패
# 로컬 개발: openssl rand -hex 32 로 생성 후 workplace-ai-agent .env 와 동일 값으로 설정
# 운영: api(WORKPLACE_AI_AGENT_TOKEN) ↔ ai-agent(INTERNAL_SERVICE_TOKEN) 동일 값
WORKPLACE_AI_AGENT_TOKEN=

# === 운영 전용 (docker-compose.prod.yml / ~/prod/smart-workplace/.env) ===
# CORS 허용 오리진 — web(:10000)·admin(:10001) 및 외부 호스트. 콤마 구분.
# 누락/오기 시 브라우저 POST 가 Spring CORS 에서 403. 외부 접속 시 실제 공개 호스트도 추가.
CORS_ALLOWED_ORIGINS=http://localhost:10000,http://localhost:10001
# 외부 노출 포트 (호스트 측). fire-hub(8888/9998)와 비충돌.
WEB_PORT=10000
ADMIN_PORT=10001
# (참고) AI 모델 인증은 .env 키가 아니라 AGENT별 OAuth 토큰(workplace-api DB)으로 동작한다.
#        ai-agent cli-runner 가 ANTHROPIC_API_KEY 를 spawn 전에 삭제하므로 아래 키는 현재 무효.
#        운영 AI 응답은 배포 후 web/admin 의 AGENT 관리 화면에서 OAuth 토큰을 등록해야 한다.
# ANTHROPIC_API_KEY=
# BEDROCK_API_KEY=
