{
  "name": "smart-workplace",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/free-ports.mjs 6060 6070 6080 6090 6173 6174 && turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:logs": "docker compose logs -f db",
    "prepare": "husky"
  },
  "//lint-staged-note": "lint-staged 설정은 lint-staged.config.mjs 참조(앱별 eslint --fix 게이트). Java 포맷은 gradle test 내 Spotless 가 검증.",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "turbo": "^2.5.0"
  },
  "packageManager": "pnpm@10.11.0"
}
