{
  "name": "smart-workplace",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/free-ports.mjs 6060 6070 6080 6090 6095 6173 6174 && turbo run dev",
    "test": "turbo run test",
    "test:plugin": "node --test plugins/genia-works/tests/*.test.mjs",
    "test:helm": "node --test deploy/helm/tests/*.test.mjs",
    "test:release": "node --test deploy/release/tests/*.test.mjs",
    "manual:check": "node docs/manual/scripts/check.mjs",
    "manual:prose": "node docs/manual/scripts/prose.mjs",
    "manual:pdf": "node docs/manual/scripts/build.mjs",
    "manual:shots": "node docs/manual/scripts/capture.mjs",
    "test:manual": "node --test docs/manual/scripts/*.test.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:hooks": "for t in scripts/husky/*.test.sh; do sh \"$t\" || exit 1; done",
    "test:full": "sh scripts/husky/full-regression.sh",
    "train": "sh scripts/husky/train.sh",
    "check:migrations": "node scripts/check-migration-versions.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typecheck:image": "node scripts/image-typecheck.mjs",
    "clean": "turbo run clean",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:logs": "docker compose logs -f db",
    "prepare": "husky"
  },
  "//lint-staged-note": "lint-staged 설정은 lint-staged.config.mjs 참조(앱별 eslint --fix 게이트). Java 포맷은 gradle test 내 Spotless 가 검증.",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "marked": "18.0.10",
    "turbo": "^2.5.0"
  },
  "packageManager": "pnpm@10.11.0"
}
