#!/usr/bin/env bash
# Claude Code 작업 공간 엔트리포인트(WP-1252) — runner 가 만든 AI Pod 에서 사람 손 없이 Claude Code·플러그인·저장소·work-loop 칸을 띄우고 지킨다.
# 순서는 계획(2026-11-01-wp1245-agent-runtime-wave-c.md Task 5)의 1~9단계, 함수는 bin/lib.sh. Pod 계약은 docs/integrations/agent-pod-contract.md.
# - 칸(work-loop)이 DRAIN·RESTART 로 멈춰도 끝내지 않는다 — 끝내면 kubelet 이 같은 generation 으로 다시 띄워 헛돈다(교체는 runner 가 Pod 를 지워서 한다).
# - SIGTERM 에는 칸들을 정리하고 0 으로 끝낸다.
set -o pipefail
here=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=lib.sh
. "$here/lib.sh"

# 종료 신호 trap(lib.sh 의 on_term) — 부팅 도중에 온 신호도 정리하고 0 으로 끝내게 부팅 단계 앞에서 건다.
install_term_trap

# 1. 필수 파일·env, /work 폴더(TMPDIR 이 있어야 플러그인 명령이 돈다)
check_required
prepare_dirs
start_display
# 1b. 추가 CA(사내 GitLab 등 자체서명) — 이 뒤의 모든 연결(플러그인·저장소·칸)이 쓰게 먼저 합친다.
setup_ca
# 2. 플러그인 — genia-works 마켓플레이스를 이 Works 로 맞추고 서버 버전을 받는다(실패해도 굳힌 버전으로 계속).
#    스크립트 폴더를 찾아 플러그인 공용 함수(gw-lib)를 읽는다 — 못 찾으면 띄울 수 없다. 이 뒤로는 gw-lib 를 쓴다.
update_plugins
resolve_plugin_scripts || die "genia-works 플러그인을 찾지 못했습니다 — 이미지를 다시 빌드하세요"
log "Claude Code $(claude --version 2>/dev/null | head -n 1) · 플러그인 $GW_SCRIPTS"
# 3. Claude Code 설정(매번 덮어씀 — 2번이 정한 마켓플레이스 주소로)
write_settings || die "$HOME/.claude/settings.json 을 쓰지 못했습니다"
# 4. 첫 실행 창·폴더 신뢰(저장소 폴더는 7번에서 더한다)
mark_trust "$AI_HOME" "$AI_DIR" || die "$HOME/.claude.json 을 쓰지 못했습니다"
# 5. AI 키(플러그인의 gw-keys 로 검사·저장)·git·저장소 자격 증명(GitHub·GitLab)
install_key || die "AI 키를 놓지 못했습니다"
setup_git
# 6. dind
wait_dind
# 7·8. 프로젝트마다 저장소·칸을 띄우고(목록을 못 읽으면 감독이 다시 한다) 알림 감시 창을 한 번 챙긴 뒤, 회차마다 감독한다(supervise_once).
#      lib.sh 의 run_supervisor boot — 첫 감독 전에 한 회차 쉰다. 돌아오지 않는다(끝은 on_term).
run_supervisor boot
