{
  "name": "@smart-workplace/workplace-agent-runner",
  "version": "0.0.1",
  "description": "실행 위치(쿠버네티스 네임스페이스)에서 Works 의 원하는 상태대로 AI Pod 를 맞추는 runner",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start:local": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@kubernetes/client-node": "2.0.1",
    "ws": "8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.4",
    "@types/ws": "8.18.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  }
}
