#!/usr/bin/env bash
# OpenCode 작업 공간 엔트리포인트(WP-1410) — runner 가 만든 AI Pod 에서 사람 손 없이 OpenCode·플러그인·저장소·work-loop 칸을 띄우고 지킨다.
# 공용 함수는 Claude Code 이미지의 lib.sh(같은 파일을 COPY), OpenCode 전용은 lib-opencode.sh(뒤에 읽어 덮어쓴다). Pod 계약은 docs/integrations/agent-pod-contract.md.
# 모양은 Codex 엔트리포인트와 같다:
# - 칸(work-loop)이 DRAIN·RESTART 로 멈춰도 끝내지 않는다 — 끝내면 kubelet 이 같은 generation 으로 다시 띄워 헛돈다(교체는 runner 가 Pod 를 지워서 한다).
# - SIGTERM 에는 칸들을 정리하고 0 으로 끝낸다.
# - 연결 정보가 없거나 모델을 정할 수 없는 동안은 칸을 띄우지 않는다(감독은 돌되 아무것도 하지 않는다).
set -o pipefail
here=$(cd "$(dirname "$0")" && pwd)
# 이미지는 lib.sh 를 같은 폴더(/opt/genia/bin)에 COPY 한다. 저장소에서 돌릴 때(테스트)는 Claude Code 이미지 폴더의 것을 읽는다.
lib="$here/lib.sh"
[ -f "$lib" ] || lib="$here/../../workplace-agent-claude-code/bin/lib.sh"
# shellcheck source=../../workplace-agent-claude-code/bin/lib.sh
. "$lib"
# shellcheck source=lib-opencode.sh
. "$here/lib-opencode.sh"

SLEEP_PID=""
on_term() {
  trap - TERM INT
  [ -n "$SLEEP_PID" ] && kill "$SLEEP_PID" 2>/dev/null
  # start_projects 가 저장소·브라우저를 받는 중이었다면 그 일들을 자손까지 끄고 임시 폴더를 치운다.
  abort_boot
  log "종료 신호 — 칸들을 정리합니다"
  stop_all
  exit 0
}
trap on_term TERM INT

# 1. 필수 파일·env, /work 폴더
check_required
prepare_dirs
# 1a. 가상 화면(Xvfb) — 화면 탐색 스킬이 playwright-cli --headed 로 브라우저를 띄울 수 있게 DISPLAY 를 내보낸다(WP-1404). 칸이 물려받는다.
start_display
# 1b. 추가 CA(사내 GitLab·사내 모델 서버 등) — 이 뒤의 모든 연결이 쓰게 먼저 합친다. OpenCode 는 Bun 으로 묶인 실행 파일이라 NODE_EXTRA_CA_CERTS(추가분)와
#     SSL_CERT_FILE(합친 번들)을 물려받는다(setup_ca 가 둘 다 내보낸다).
setup_ca
# 2. 플러그인(이미지에 굳힌 opencode 구동기 포함 genia-works) — 못 찾으면 띄울 수 없다. 이 뒤로는 gw-lib 를 쓴다.
use_plugin || die "genia-works 플러그인(opencode 구동기)을 찾지 못했습니다 — 이미지를 다시 빌드하세요"
log "플러그인 $GW_SCRIPTS"
# opencode 가 실제로 도는지 부팅 때 한 번 본다(버전은 Dockerfile 의 ARG OPENCODE_VERSION 으로 고정). 답이 없으면 칸의 opencode run 도 실패한다.
opencode_version=$("${OPENCODE_BIN:-opencode}" --version 2>/dev/null </dev/null | head -n 1)
if [ -n "$opencode_version" ]; then
  log "OpenCode $opencode_version"
else
  log "경고: opencode --version 이 답하지 않습니다 — OpenCode CLI 가 이미지에 없거나 실행되지 않습니다(칸의 opencode run 이 실패합니다)"
fi
# 3. OpenCode 환경(대화 기록 자리 — 칸이 물려받는다)·전역 지시(superpowers 안내)·설정(연결 정보 → opencode.json)
opencode_env || die "$AI_DIR/opencode 를 만들지 못했습니다"
write_opencode_agents_md || log "경고: opencode 의 AGENTS.md(superpowers 세션 시작 안내)를 쓰지 못했습니다"
# 연결 정보가 없거나 모델을 못 정하면 이유를 로그로 남기고 칸을 띄우지 않는다(can_launch) — 끝내지 않는다.
write_opencode_config || true
# 4. AI 키·git·저장소 자격 증명
install_key || die "AI 키를 놓지 못했습니다"
setup_git
# 5. dind
wait_dind
# 6. 칸의 실행기를 opencode 로 — 플러그인 agent-project 의 opencode 분기(gw-opencode-loop)가 칸 명령을 정한다.
"$GW_SCRIPTS/agent-home" "$AI_DIR" set cli opencode || die "AI 폴더에 실행기(opencode)를 적지 못했습니다"
# 7. 감독 — 부팅 첫 회차부터 tick 하나로(칸을 띄울 수 있으면 supervise_once: 처음이면 start_projects, 그 뒤 칸 살피기·알림 감시 창).
#    sleep 을 뒤에서 돌리고 wait 로 기다려 SIGTERM 을 바로 받는다. PROJECTS_READY·BOOT_KEYS 는 lib.sh 의 start_projects·supervise_once 가 읽고 쓴다.
# shellcheck disable=SC2034
PROJECTS_READY=0
# shellcheck disable=SC2034
BOOT_KEYS=""
while :; do
  tick
  sleep "$GENIA_SUPERVISE_INTERVAL" &
  SLEEP_PID=$!
  wait "$SLEEP_PID"
  SLEEP_PID=""
done
