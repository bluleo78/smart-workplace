{
  "mcpServers": {
    "workplace": {
      "command": "node",
      "args": ["dist/mcp/workplace-mcp-server.js"],
      "env": {
        "WORKPLACE_API_BASE_URL": "${WORKPLACE_API_BASE_URL}",
        "INTERNAL_SERVICE_TOKEN": "${INTERNAL_SERVICE_TOKEN}",
        "ACTING_AGENT_ID": "${ACTING_AGENT_ID}"
      }
    }
  }
}
