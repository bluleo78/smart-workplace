{
  "name": "@smart-workplace/workplace-collab",
  "version": "0.0.1",
  "description": "Real-time note co-editing sync server (Hocuspocus) for Smart Workplace",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "dev": "set -a; [ -f ../../.env ] && . ../../.env; set +a; export COLLAB_DEV_DEFAULTS=1; exec tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "start:test": "COLLAB_TEST_MODE=1 tsx src/index.ts",
    "dryrun": "tsx src/scripts/dryRun.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@hocuspocus/server": "4.7.0",
    "@smart-workplace/wiki-editor-schema": "workspace:*",
    "@tiptap/core": "2.27.2",
    "@tiptap/extension-image": "2.27.2",
    "@tiptap/extension-table": "2.27.2",
    "@tiptap/extension-table-cell": "2.27.2",
    "@tiptap/extension-table-header": "2.27.2",
    "@tiptap/extension-table-row": "2.27.2",
    "@tiptap/extension-text": "2.27.2",
    "@tiptap/pm": "2.27.2",
    "@tiptap/starter-kit": "2.27.2",
    "dotenv": "^16.4.7",
    "happy-dom": "^20.0.0",
    "markdown-it": "14.2.0",
    "tiptap-markdown": "0.8.10",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@hocuspocus/provider": "4.7.0",
    "@types/node": "^22.19.19",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  }
}
