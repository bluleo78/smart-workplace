#!/bin/sh
# gw-claude-run <토큰 파일> <명령…> — tmux 칸에서 claude 를 띄우기 직전에 모델 로그인을 정하고 <명령> 으로 넘어간다(WP-1334).
#   agent-project start 가 부른 셸의 CLAUDE_CODE_OAUTH_TOKEN(홈 claude 를 setup-token 으로 띄움)을 <토큰 파일>(권한 600)에 적어 두면
#   여기서 읽어 넣는다 — 토큰을 칸 명령 인자로 넘기면 ps·tmux 의 pane_start_command 에 원문이 남아서 파일로만 건넨다.
#   파일이 있으면 ANTHROPIC_API_KEY·ANTHROPIC_AUTH_TOKEN 을 비운다 — claude 는 그 둘을 setup-token 보다 먼저 써서, tmux 서버 환경에
#   남아 있으면 토큰이 무시된다. 파일이 없으면 CLAUDE_CODE_OAUTH_TOKEN 을 비워 이 컴퓨터의 claude 로그인을 쓴다 — tmux 서버가
#   예전에 토큰 있는 셸에서 떠 그 값을 물려주더라도 「토큰 없이 띄움 = 로컬 로그인」이 되게.
tokfile=${1:?사용: gw-claude-run <토큰 파일> <명령…>}
shift
if [ -s "$tokfile" ]; then
  CLAUDE_CODE_OAUTH_TOKEN=$(cat "$tokfile") || exit 1
  export CLAUDE_CODE_OAUTH_TOKEN
  unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN
else
  unset CLAUDE_CODE_OAUTH_TOKEN
fi
exec "$@"
