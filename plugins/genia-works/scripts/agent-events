#!/bin/sh
# agent-events — AI 하나의 알림 연결을 상시 들고 있는 감시(WP-1252). Works 화면의 「연결됨」은 그 AI 의 알림 SSE 가 지금 열려 있는지로
# 정해지는데, work-loop 칸의 Monitor(30분 제한)로만 걸면 다시 걸지 않은 틈에 「연결 끊김」이 되고 알림에 깨어나지 못한다.
# 그래서 AI 마다 tmux 세션(agent-window 와 같은 세션)에 창 `events` 하나가 SSE 를 늘 들고 wake 줄을 <AI 폴더>/state/events.log 에 쓰고,
# 칸들은 그 파일을 따라가며 깨어나기만 한다. <AI 폴더> 는 <홈>/<AI 이름>(이름이 곧 신원·tmux 세션 이름).
#
# agent-events ensure <AI 폴더> — 감시 창이 없거나 죽었으면 띄운다. 결과 한 줄: started(새로 띄움) · exists(돌고 있어 둠) ·
#   revived(죽은 창을 그 자리에서 다시 띄움) · no-tmux(tmux 없음, 종료 3). 같은 AI 의 칸 여럿·agent-window 와 동시에 불러도
#   세션 잠금(agent-window 와 같은 잠금)으로 차례로 해 창은 하나만 생긴다(SSE 연결은 사용자당 5개 상한).
# agent-events run <AI 폴더> — 감시 창 안에서 도는 본체. 그 AI 신원으로 gw-events --all 을 끝없이 다시 띄우며 출력 줄을 events.log 에 덧붙인다.
#   gw-events 는 스스로 다시 붙으므로(끊긴 사이는 「wake - reconnect」) 여기서 다시 띄우는 것은 gw-events 가 끝났을 때뿐이다 —
#   「gw-events: …」 줄(AI 키 신원 아님·인증 실패)로 끝났으면 5분 쉬고, 그 밖이면 1초부터 30초까지 늘려 가며 쉰다.
#   gw-events 는 <AI 폴더>/state/events.pid 로 잠가 하나만 돈다. 로그가 1MB 를 넘으면 events.log.1 로 넘기고 새로 쓴다.
# agent-events tail <AI 폴더> <프로젝트 키[,키…]> — work-loop 의 Monitor 가 거는 명령. ensure 를 한 번 부른 뒤 events.log 를 지금 끝부터
#   따라가며 그 프로젝트의 「wake <키>-…」 줄과 「wake - …」(다시 붙음) 줄만 낸다. 감시 연결은 창이 들고 있으므로 이 명령이 끝나도 끊기지 않는다.
# agent-events open <AI 폴더> <프로젝트 키> — 칸이 없는 프로젝트의 알림이 오면 run 이 뒤에서 부른다(WP-1272). 정기 「새 프로젝트 확인」(work-loop,
#   깨어날 때 5분에 한 번)을 기다리면 쉬는 칸만 있는 AI 는 다음 확인까지 새로 맡은 일을 시작하지 않는다. 칸이 이미 있으면 아무것도 안 하고,
#   없으면 맡는 프로젝트(gw-agent-projects --assigned)를 다시 읽어 그 키가 있으면 agent-project add 로 받고 칸을 띄운다.
#   같은 프로젝트 알림이 연달아 와도 키마다 잠가(<AI 폴더>/state/open-<키>.lock) 하나만 하고, agent-project 의 잠금(busy)·실패 대기(backoff)를 그대로 쓴다.
#   맡는 프로젝트에 없으면(저장소 미연결·멤버 아님) 10분 동안 그 키로 다시 묻지 않는다. 결과는 events.log 에 「open <키> <결과>」 한 줄로 남긴다
#   (tail 은 wake 줄만 내므로 칸을 깨우지 않는다).
# agent-events poke <AI 폴더> <프로젝트 키|-> — 쉬는 Claude Code 칸에 「/loop /genia-works:work-loop <인자>」를 넣어 깨운다(WP-1403). run 이 wake 줄마다
#   뒤에서 부른다(「wake <키>-…」는 그 키, 「wake - …」(다시 붙음)는 - — 그 AI 의 모든 칸). 칸의 모델이 Monitor 걸기를 건너뛰거나 30분 뒤 다시 걸지 않으면
#   알림이 칸에 닿지 않았다 — genia·Codex 칸처럼 깨우기를 감시 창이 맡는다. 실행기가 claude 일 때만 한다(genia·codex 는 실행기가 이미 깨운다).
#   넣는 것은 칸이 쉬고 있다고 화면으로 확인될 때뿐이다(사람이 친 글자·하던 일을 지키는 것이 먼저 — 놓친 알림은 정기 확인이 메운다):
#     칸이 살아 있고, 사람이 그 칸을 보고 있지 않고(붙은 화면의 활성 칸), 입력 상자(위아래 ─ 줄 사이, ❯ 로 시작)를 찾았고,
#     상자 바로 위에 일하는 중 표시(「✻ 동사… (8s · …)」·「Running…」·「Waiting…」·예전 판의 「esc to interrupt」)가 없고,
#     상자 안이 비었거나 흐린 글자(안내문·다음 지시 제안, SGR 2)뿐일 때.
#   막 뜬 칸(띄운 지 60초 안 — agent-window 가 다는 @gw_started, GW_POKE_FRESH_SEC)이나 open 이 그 키를 여는 중(open-<키>.lock)이면 starting —
#   칸 명령의 첫 /loop 가 아직 제출되지 않았을 수 있어 겹쳐 넣지 않는다.
#   쉬지 않으면(busy·typing·unknown·attached·starting) 알림을 버리지 않고 키 잠금을 쥔 채 15초마다 다시 보며 5분까지 기다리다 쉬게 되면 넣는다 —
#   일하는 중에 온 알림을 다음 정기 확인(20~30분 뒤)까지 미루지 않게. 간격·한도(초)는 GW_POKE_RETRY_SEC·GW_POKE_RETRY_MAX 로 바꿀 수 있다(테스트용).
#   같은 키는 60초에 한 번만 넣고(<AI 폴더>/state/poke-<키> — 넣었을 때만 표시), 동시 poke 는 키마다 잠가(poke-<키>.lock) 하나만 한다 —
#   기다리는 poke 가 있으면 뒤의 poke 는 아무것도 남기지 않고 끝난다(기다리는 쪽이 맡는다).
#   결과는 끝에 한 번 events.log 에 「poke <키> <sent|sent-after-wait|busy|typing|unknown|attached|starting|dead|debounced|no-pane|not-claude|failed>」
#   한 줄로 남긴다(기다렸다 넣었으면 sent-after-wait, 한도까지 못 넣었으면 마지막 이유 — open 과 같은 방식).
# agent-events sweep <AI 폴더> — 안전장치(WP-1427): 알림이 없어도 오래 쉬는 칸을 깨운다. 칸이 다음 확인을 못 잡아 멈추면(깨우기 판단 오류 등) 알림이
#   와야만 깨어나는데 알림이 없으면 몇 시간이고 서 있었다. run 이 띄운 sweep-loop 가 GW_IDLE_SWEEP_SEC(기본 300초)마다 부른다. 칸마다(--pane-keys)
#   화면이 idle 로 읽히는 동안 <AI 폴더>/state/idle-<키> 에 「<처음 idle 로 본 시각> <화면 지문>」을 적는다. 지문은 입력 상자 위쪽(대화 영역 —
#   입력 줄 바로 위의 가로 구분선 앞까지)의 색 코드 없는 글자의 cksum 이다 — 아래쪽 상태 줄(남은 시간·ctx%·모델 이름)이 바뀌어도 다시 세지 않게.
#   다음 표본에서 지문이 달라졌으면 그 사이 칸이 출력한 것(잠깐이라도 일했다 — 5분 표본은 2~3분 일하고 다시 쉰 칸도 idle 로 찍는다)이라 지금부터 다시 센다.
#   지문을 얻지 못하면(화면을 못 읽음·입력 줄을 못 찾음) 빈 지문이고, 빈 지문은 기록과 같아도 맞은 것으로 치지 않는다(넣지 않는 쪽).
#   지문이 같은 채로 GW_IDLE_POKE_SECS(기본 3600초 = 1시간)가 넘으면 기존 poke 경로로 「/loop …」를 넣은 뒤 지금 시각·지금 지문으로 고친다 —
#   같은 칸에 1시간에 한 번만. 일하는 중(busy)·입력 중(typing)·unknown·막 뜬 칸·사람이 보는 칸은 idle 이 아니므로 기록을 지우고 넣지 않는다.
#   이제 없는 칸의 기록도 지운다. run 은 시작할 때 idle-* 기록을 모두 지운다 — 감시 창이 오래 죽었다 살아나도 지금부터 1시간을 센다(한꺼번에 깨우지 않는다).
#   실행기가 claude 가 아니면 하지 않는다(poke 와 같다). poke 의 결과는 events.log 에 poke 줄로 남는다.
# agent-events sweep-loop <AI 폴더> — run 이 뒤에서 띄우는 주기 점검(따로 된 프로세스). run 이 끝나며 신호를 보내면 자기가 띄운 sweep(과 그 poke)까지 끝낸다.
# 키는 gw-events 가 키 파일에서 읽어 표준 입력으로만 쓴다 — 이 스크립트는 키를 읽지도, 인자·로그에 남기지도 않는다.
here=$(cd "$(dirname "$0")" && pwd)
. "$here/gw-lib.sh"
# GW_TMUX 는 테스트 전용 훅(격리한 tmux 서버) — 운영에서는 설정하지 않는다.
tmux=${GW_TMUX:-tmux}
win=events

usage() {
  echo "사용: agent-events ensure|run <AI 폴더> · tail <AI 폴더> <프로젝트 키[,키…]> · open <AI 폴더> <프로젝트 키> · poke <AI 폴더> <프로젝트 키|-> · sweep|sweep-loop <AI 폴더>" >&2
  exit 2
}

cmd=${1:-}
[ -n "$cmd" ] || usage
aidir=$(gw_ai_dir "${2:-}") || { echo "AI 폴더가 아닙니다: ${2:-}" >&2; exit 2; }
name=$(basename "$aidir")
state="$aidir/state"
log="$state/events.log"

do_ensure() {
  if ! command -v "$tmux" >/dev/null 2>&1; then
    echo no-tmux
    exit 3
  fi
  session=$(gw_tmux_name "$name")
  # agent-window 와 같은 잠금 — 세션이 없을 때 둘이 함께 new-session 하거나, 칸 여럿이 함께 감시 창을 띄우지 않게.
  if ! gw_session_lock "$session"; then
    echo "agent-events: $session 세션을 다른 쪽이 다루고 있습니다" >&2
    exit 1
  fi
  # 새 창은 이 셸이 아니라 tmux 서버의 환경을 물려받는다 — PATH 와 운영이 아닌 서버 주소·워크스페이스를 넘긴다(agent-window 칸과 같은 GW_TMUX_ENV).
  set -- "$here/agent-events" run "$aidir"
  eval "set -- env $GW_TMUX_ENV \"\$@\""
  # setup-token 은 tmux 서버 환경으로 새지 않게 지운다(WP-1334).
  gw_scrub_claude_token

  if listing=$("$tmux" list-panes -s -t "=$session" -F '#W #{pane_id} #{pane_dead}' 2>/dev/null); then
    found=$(printf '%s\n' "$listing" | awk -v w="$win" '$1 == w { print $2, $3; exit }')
    if [ -n "$found" ]; then
      if [ "${found#* }" != 1 ]; then
        echo exists
        exit 0
      fi
      "$tmux" respawn-pane -k -t "${found% *}" -c "$aidir" "$@" >/dev/null || exit 1
      echo revived
      exit 0
    fi
    pane=$("$tmux" new-window -d -t "=$session:" -n "$win" -c "$aidir" -P -F '#{pane_id}' cat) || exit 1
  else
    # 감시 창이 세션의 첫 창이 되는 경우(칸보다 먼저) — agent-window 처럼 넉넉한 크기로 만든다.
    pane=$("$tmux" new-session -d -s "$session" -n "$win" -x 240 -y 60 -c "$aidir" -P -F '#{pane_id}' cat) || exit 1
  fi
  # agent-window 와 같은 자리 잡기 — cat 으로 창을 먼저 만들어 끝난 명령의 창을 남기게(remain-on-exit) 한 뒤 진짜 명령으로 바꾼다.
  # 감시가 곧바로 죽어도 창이 사라지지 않아 다음 ensure 가 revived 로 다시 띄운다(감시 창만 있는 세션이 통째로 사라지지도 않는다).
  "$tmux" set-option -w -t "$pane" remain-on-exit on >/dev/null &&
    "$tmux" respawn-pane -k -t "$pane" -c "$aidir" "$@" >/dev/null || exit 1
  echo started
}

# 쉬기 — 앞쪽 sleep 을 기다리는 동안에는 trap 이 돌지 않아 창을 닫거나 다시 띄워도(SIGHUP) 5분 동안 남아
# 그 뒤 gw-events 를 또 띄우게 된다(감시가 둘). 뒤에서 재우고 wait 로 기다려 신호를 바로 받는다.
nap() {
  sleep "$1" &
  wait $!
}

# 끝날 때 자식(gw-events·curl·tail)을 함께 끝낸다 — 창이 닫히거나 다시 띄워지면(respawn -k), Monitor 가 멈추면 신호가 온다.
# 앞쪽에서 기다리는 동안에는 trap 이 돌지 않으므로 부르는 쪽은 파이프라인을 뒤에서 돌리고 wait 로 기다린다.
# EXIT trap 을 바꾸므로 gw_dir_lock(잠금을 푸는 EXIT trap)을 쓰는 ensure 와 한 프로세스에서 함께 쓰지 않는다.
kill_children_on_exit() {
  trap 'pkill -P $$ 2>/dev/null' EXIT
  trap 'exit 143' TERM INT HUP
}

do_run() {
  mkdir -p "$state" || exit 1
  # 감시 창은 모델 로그인이 필요 없다 — 예전(0.1.34 이하) tmux 서버가 토큰 있는 셸에서 떠 물려준 토큰이 있으면, 여기서 부르는
  # agent-project add 가 그 옛 토큰을 파일에 되써 버린다(WP-1334).
  gw_scrub_claude_token
  # gw-events·curl 이 남아 SSE 연결과 잠금을 붙잡지 않게.
  kill_children_on_exit
  # 안전장치(WP-1427) — 알림이 없어도 오래 쉬는 칸을 깨운다. 감시 창이 (오래) 죽었다 살아났으면 지난 idle 기록은 믿을 수 없다 —
  # 모두 지워 지금부터 1시간을 센다(살아나자마자 한꺼번에 깨우지 않게).
  rm -f "$state"/idle-*
  # 따로 된 프로세스로 띄운다 — 자기 $$ 로 자식(sweep·poke)을 끝낼 수 있게(하위 셸의 $$ 는 run 의 것이라 그 자식을 못 찾는다).
  # 이 프로세스는 run 의 자식이라 감시 창이 끝나면 kill_children_on_exit 이 신호를 보내고, 그러면 sweep-loop 가 자기 자식을 끝낸다.
  "$here/agent-events" sweep-loop "$aidir" </dev/null >/dev/null 2>&1 &
  backoff=1
  while :; do
    started=$(date +%s)
    # 받은 줄은 그때마다 열어 덧붙인다 — 1MB 를 넘겨 파일을 넘긴 뒤에도 새 파일에 쓰게(열어 둔 fd 를 쥐지 않는다).
    # 끝의 종료 코드로 「gw-events: …」 줄을 봤는지 알린다(파이프 끝의 while 은 하위 셸이라 변수로는 못 넘긴다).
    GENIA_WORKS_AS=$name "$here/gw-events" --all --lock "$state/events.pid" | {
      fatal=0
      while IFS= read -r line; do
        printf '%s\n' "$line" >> "$log"
        case $line in
          gw-events:*) fatal=1 ;;
          'wake - '*)
            # 다시 붙음 — 프로젝트가 없다. 끊긴 사이 놓친 알림을 확인하도록 쉬는 칸을 모두 깨운다(WP-1403).
            "$here/agent-events" poke "$aidir" - </dev/null >/dev/null 2>&1 &
            ;;
          'wake '*-*)
            # 칸이 없는 프로젝트일 수 있다 — 뒤에서 확인해 연다(받기·칸 띄우기가 길어도 알림 읽기를 막지 않게). 이슈 키 끝의 「-번호」를 떼면 프로젝트 키.
            # 칸이 있으면 쉬는 칸을 깨운다(WP-1403 — 둘 중 하나만 할 일이 있다).
            ik=${line#wake }
            ik=${ik%% *}
            "$here/agent-events" open "$aidir" "${ik%-*}" </dev/null >/dev/null 2>&1 &
            "$here/agent-events" poke "$aidir" "${ik%-*}" </dev/null >/dev/null 2>&1 &
            ;;
        esac
        if [ "$(wc -c < "$log" 2>/dev/null || echo 0)" -gt 1048576 ]; then
          # 앞부분(오래된 줄)을 떼어 낸다 — 같은 파일을 줄이면 따라가던 tail 이 처음부터 다시 읽어 옛 wake 줄을 쏟아 내므로
          # 이름을 넘기고 빈 새 파일에서 이어 쓴다(tail -F 는 새 파일을 처음부터 읽는다).
          mv -f "$log" "$log.1"
          : >> "$log"
        fi
      done
      exit "$fatal"
    } &
    if wait $!; then
      # 끝난 이유가 신원·인증이 아니다(잠금이 이미 잡혀 있음·연결 실패 등) — 오래 돌다 끝났으면 1초부터 다시 늘린다.
      ran=$(($(date +%s) - started))
      [ "$ran" -ge 60 ] && backoff=1
      nap "$backoff"
      backoff=$((backoff * 2 > 30 ? 30 : backoff * 2))
      # 붙어 있던 gw-events 가 죽었다(잠금이 잡혀 곧바로 끝난 것이 아니다 — 그건 1초 안에 끝난다). 새로 띄운 gw-events 의 첫 연결은
      # 「다시 붙음」을 내지 않으므로 여기서 대신 낸다 — 끊긴 사이 온 알림을 칸들이 한 번 확인해 메우게.
      if [ "$ran" -ge 5 ]; then
        printf 'wake - reconnect\n' >> "$log"
        "$here/agent-events" poke "$aidir" - </dev/null >/dev/null 2>&1 &
      fi
    else
      # 키가 아직 없거나 거절됐다 — 다시 붙어도 소용없으니 5분 쉬고(그사이 키를 등록하면 다음 회차에 붙는다) 다시 해 본다.
      nap 300
      backoff=1
    fi
  done
}

do_tail() {
  projects=$(gw_project_list "${1:-}")
  [ -n "$projects" ] || usage
  # 감시 창이 없거나 죽었으면 살린다 — 하위 프로세스로 부른다(ensure 의 잠금 trap 이 이 명령이 도는 내내 잠금을 쥐지 않게).
  # 결과 줄은 버린다(Monitor 는 모든 줄을 깨움으로 받는다).
  "$here/agent-events" ensure "$aidir" >/dev/null 2>&1
  mkdir -p "$state" && : >> "$log" || exit 1
  # Monitor 가 멈추면 tail 이 남지 않게.
  kill_children_on_exit
  # grep·awk 는 출력이 터미널이 아니면 모아서 내므로 줄마다 바로 내는 read 로 거른다. 지금 끝부터(-n 0) 이름을 따라간다(-F — 넘긴 뒤 새 파일).
  tail -n 0 -F "$log" 2>/dev/null | while IFS= read -r line; do
    case $line in
      'wake - '*) printf '%s\n' "$line" ;;
      'wake '*-*)
        ik=${line#wake }
        ik=${ik%% *}
        gw_issue_in_projects "$ik" "$projects" && printf '%s\n' "$line"
        ;;
    esac
  done &
  wait $!
}

# note <종류> <키> <결과> — 결과 한 줄(「open WP started」·「poke WP busy」)을 기록에 남긴다. 사람이 감시 창 기록에서 왜 칸이 열리지 않았는지·
# 왜 깨우지 않았는지 볼 수 있게. tail 은 wake 줄만 내므로 이 줄은 칸을 깨우지 않는다.
note() {
  mkdir -p "$state" && printf '%s %s %s\n' "$1" "$2" "$3" >> "$log"
}

# 그 프로젝트 칸이 없으면 0. tmux 를 못 읽으면 지금은 모른다 — 없다고 보지 않는다(다음 알림·정기 확인에 맡긴다).
pane_missing() {
  m=$("$here/agent-home" "$aidir" missing "$1" 2>/dev/null) && [ "$m" = "$1" ]
}

do_open() {
  key=${1:-}
  gw_valid_project_key "$key" || usage
  # 맡지 않는 프로젝트로 판정한 키는 10분 동안 묻지 않는다 — 칸 확인(tmux 조회)보다 싸므로 먼저 본다.
  skip="$state/open-skip-$key"
  [ -n "$(find "$skip" -mmin -10 2>/dev/null)" ] && exit 0
  # 칸이 이미 있으면(대부분의 알림) 아무것도 하지 않는다.
  pane_missing "$key" || exit 0
  mkdir -p "$state" || exit 1
  # 같은 키의 알림 여럿이 함께 와도 하나만 — 잡지 못하면 다른 쪽이 하고 있다.
  gw_dir_lock "$state/open-$key.lock" || exit 0
  # 잠금을 기다리는 사이 앞선 쪽이 칸을 띄웠을 수 있다 — 다시 본다(같은 받기·칸 띄우기를 두 번 하지 않게).
  pane_missing "$key" || exit 0
  list=$("$here/gw-agent-projects" --assigned "$name" </dev/null 2>/dev/null) || {
    note open "$key" "projects-failed"
    exit 0
  }
  tab=$(printf '\t')
  line=$(printf '%s\n' "$list" | awk -F "$tab" -v k="$key" '$1 == k { print; exit }')
  if [ -z "$line" ]; then
    # 맡는 프로젝트가 아니다(저장소 미연결·멤버 아님) — 그 프로젝트의 알림이 이어져도 10분은 다시 묻지 않는다.
    : > "$skip"
    note open "$key" "not-assigned"
    exit 0
  fi
  url=$(printf '%s' "$line" | cut -f2)
  branch=$(printf '%s' "$line" | cut -f3)
  out=$("$here/agent-project" add "$aidir" "$key" "$url" ${branch:+"$branch"} </dev/null 2>&1)
  rc=$?
  case $rc in
    0) note open "$key" "started" ;;
    6 | 7) ;; # busy(다른 쪽이 하는 중)·backoff(1시간 안에 실패) — agent-project 가 이미 다룬다
    *) note open "$key" "failed $(printf '%s\n' "$out" | tail -n 1)" ;;
  esac
  exit 0
}

# 칸 화면(capture-pane -e — 색 코드 포함)을 읽어 idle·busy·typing·unknown 중 하나를 낸다(WP-1403). Claude Code v2.1 의 모양 기준:
#   입력 상자는 화면 맨 아래쪽의 ─ 줄 둘 사이이고 첫 줄이 「❯」 뒤 공백(실제로는 줄바꿈 없는 공백 U+00A0, 예전 판은 「> 」)으로 시작한다 —
#   위쪽 기록에도 ❯ 로 시작하는 지난 지시 줄이 있어 ─ 줄로 상자를 찾는다. 상자를 못 찾으면(확인 창·메뉴 등) unknown.
#   마지막 출력 블록(⏺ 로 시작하는 줄)부터 상자 위까지에 일하는 중 표시가 있으면 busy(할 일 목록이 길면 스피너가 상자에서 멀어 몇 줄만 보면 놓친다) —
#   스피너 줄(줄 첫 글자가 스피너 글자 ✻✳✶✢✽·* 이고 「…」로 끝나는 낱말 하나가 뒤따름: 「✻ Effecting… (8s · …)」·「✳ Wrangling…」),
#   도구 줄(「⎿  Running…」·「⎿  Waiting…」 그대로), 예전 판의 「esc to interrupt」. 모델이 쓴 글이 「…」로 끝나는 것은 일하는 중이 아니다.
#   턴은 끝났어도 뒤에서 돌리는 셸·에이전트가 남아 있으면 상자 아래 상태 줄에 「· 1 shell」이 보인다 — busy(그 일이 끝나면 칸이 알림을 받아
#   이어 가므로 새 /loop 를 겹쳐 넣지 않는다). 이 표시는 상자 아래에서만 본다(기록 글에 같은 낱말이 있어도 잘못 읽지 않게). 끝난 줄 「✻ Baked for 26s · done …」에는 둘 다 없다.
#   상자 안에 흐리지 않은 글자가 있으면 typing — 안내문(「Try "…"」)·다음 지시 제안은 흐린 글자(SGR 2)로 그려진다. 반전 칸(SGR 7, 가짜 커서)은 typed() 참고. 판정이 서지 않는 모양은 넣지 않는 쪽으로 둔다.
# awk 는 바이트 단위로 돌린다(LC_ALL=C — awk 마다 다른 UTF-8 처리를 피한다) — ❯·─·…·U+00A0 는 바이트열 그대로 맞춘다.
classify_screen() {
  LC_ALL=C awk '
    function strip(s) { gsub(/\033\][^\033]*\033\\/, "", s); gsub(/\033\[[0-9;?]*[A-Za-z]/, "", s); return s }
    function trim(t) { gsub(/\302\240/, " ", t); sub(/[ \t]+$/, "", t); return t }
    function isrule(t) { t = trim(t); if (t == "") return 0; gsub(/─/, "", t); return t == "" }
    # SGR 인자를 읽어 흐림(DIM)·반전(INV) 상태를 바꾼다 — 38/48/58 의 색 값(5;N·2;R;G;B)은 건너뛴다(그 안의 2·7 을 잘못 읽지 않게).
    function sgr(seq,   p, n, k, v) {
      n = split(seq, p, ";")
      if (n == 0) { DIM = INV = 0; return }
      for (k = 1; k <= n; k++) {
        v = p[k] + 0
        if (v == 0) DIM = INV = 0
        else if (v == 2) DIM = 1
        else if (v == 22) DIM = 0
        else if (v == 7) INV = 1
        else if (v == 27) INV = 0
        else if (v == 38 || v == 48 || v == 58) { if (p[k + 1] == "5") k += 2; else if (p[k + 1] == "2") k += 4 }
      }
    }
    # 사람이 친 글자가 있으면 1. 색 코드(CSI)·링크(OSC)는 글자가 아니다. 흐린 글자는 안내문·제안이다.
    # 반전 칸은 ink 가 그리는 가짜 커서다 — 빈 칸이면 무시하고, 글자 위에 있으면 바로 뒤가 흐린 글자(안내문 첫 글자 위의 커서)일 때만 무시한다
    # (친 한 글자 위에 커서가 있는 것과 가르려고 — 뒤에 흐린 글자가 없으면 친 글자로 본다).
    function typed(s,   n, i, j, c, seq, rest, pend) {
      DIM = INV = pend = 0
      gsub(/\302\240/, " ", s)
      n = length(s)
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (c == "\033") {
          if (substr(s, i + 1, 1) == "[") {
            seq = ""
            for (j = i + 2; j <= n && substr(s, j, 1) ~ /[0-9;?]/; j++) seq = seq substr(s, j, 1)
            if (substr(s, j, 1) == "m") sgr(seq)
            i = j
          } else if (substr(s, i + 1, 1) == "]") {
            rest = substr(s, i + 2)
            j = index(rest, "\033\\")
            if (!j) return 1
            i = i + j + 2
          } else i++
          continue
        }
        if (c == " " || c == "\t") continue
        if (INV) { if (!DIM) pend = 1; continue }
        if (DIM) { pend = 0; continue }
        return 1
      }
      return pend
    }
    { raw[NR] = $0; plain[NR] = strip($0) }
    END {
      r1 = r2 = 0
      for (i = NR; i >= 1; i--) if (isrule(plain[i])) { if (!r2) r2 = i; else { r1 = i; break } }
      if (!r1 || r2 - r1 < 2 || plain[r1 + 1] !~ /^(❯|>)( |\302\240|$)/) { print "unknown"; exit }
      for (i = r1 - 1; i >= 1; i--) {
        t = trim(plain[i])
        sub(/^ +/, "", t)
        # 스피너 줄 — 스피너 글자 하나, 공백, 「…」로 끝나는 낱말, 그 뒤 끝 또는 「 (」. 도구 줄 — 「⎿」 뒤가 Running… / Waiting… 뿐.
        if (t ~ /^(✻|✳|✶|✢|✽|·|\*) [^ ]+…( \(|$)/ || t ~ /^⎿ +(Running|Waiting)…$/ || index(t, "esc to interrupt")) { print "busy"; exit }
        if (t ~ /^⏺/) break
      }
      # 뒤에서 도는 셸·에이전트는 상자 아래 상태 줄에만 본다(「· 1 shell」·「2 shells」·「still running」).
      for (i = r2 + 1; i <= NR; i++) {
        t = trim(plain[i])
        if (t ~ /(^|[^0-9])[0-9]+ (shells?|agents?|background tasks?)( |$|·)/ || index(t, "still running")) { print "busy"; exit }
      }
      for (i = r1 + 1; i < r2; i++) {
        s = raw[i]
        # 첫 줄의 프롬프트 글자(❯ 또는 >)는 입력이 아니다 — 처음 하나만 뗀다.
        if (i == r1 + 1) { if (index(s, "❯")) sub(/❯/, "", s); else sub(/>/, "", s) }
        if (typed(s)) { print "typing"; exit }
      }
      print "idle"
    }'
}

# pane_state <키> — 그 키 칸의 지금 상태를 st 에 둔다(poke·sweep 이 같은 기준으로 판정하게 한곳에 둔다). 칸 id 는 pane, 읽은 화면(색 코드 포함)은 shot.
#   st: dead(죽음) · starting(막 뜬 칸 — 띄운 지 GW_POKE_FRESH_SEC(기본 60초) 안 — 또는 open 이 그 키를 여는 중) · attached(사람이 보고 있음) ·
#       idle·busy·typing·unknown(화면 판정 — classify_screen. 화면을 못 읽으면 unknown).
#   종료: 0 판정함 · 1 그 키 칸이 없음 · 그 밖 tmux·세션 없음(agent-window --pane 의 코드 그대로).
pane_state() {
  ps_key=$1
  # 칸 표시 방식은 agent-window 만 안다 — 칸 id·죽음 여부·사람이 보고 있는지·띄운 지 몇 초를 받는다.
  info=$("$here/agent-window" --pane "$name" "$ps_key" 2>/dev/null)
  ps_rc=$?
  [ "$ps_rc" -eq 0 ] || return "$ps_rc"
  # shellcheck disable=SC2086 # 「<칸 id> <죽음> <보고 있음> <띄운 지 몇 초>」 네 낱말로 나눈다.
  set -- $info
  pane=$1
  shot=
  fresh=${GW_POKE_FRESH_SEC:-60}
  if [ "$2" = 1 ]; then
    st=dead
  elif [ -d "$state/open-$ps_key.lock" ] || { [ "${4:--1}" -ge 0 ] && [ "${4:--1}" -lt "$fresh" ]; }; then
    # 막 뜬 칸(open·start 가 띄우거나 다시 띄운 지 fresh 초 안) 또는 open 이 그 키를 여는 중 — 칸 명령의 첫 /loop 가 아직 제출되지 않았을 수 있어
    # 겹쳐 넣지 않는다. 띄운 시각을 모르는 칸(-1, 이 판 전에 띄움)은 오래된 칸으로 본다.
    st=starting
  elif [ "$3" = 1 ]; then
    # 사람이 그 칸을 보고 있다 — 치는 중일 수 있으니 넣지 않는다(떠나면 다음 회에 넣는다).
    st=attached
  else
    shot=$("$tmux" capture-pane -e -p -t "$pane" 2>/dev/null)
    st=$(printf '%s\n' "$shot" | classify_screen)
    st=${st:-unknown}
  fi
  return 0
}

# 칸 화면(표준 입력, 색 코드 포함)에서 대화 영역 — 입력 상자 위의 가로 구분선 앞까지 — 를 색 코드 없이 낸다(줄 끝 공백은 뗀다).
# 입력 상자는 classify_screen 과 같은 규칙(아래에서 찾은 ─ 줄 둘 사이, 첫 줄이 ❯ 또는 >)으로 찾는다. 못 찾으면 아무것도 내지 않는다.
conversation_area() {
  LC_ALL=C awk '
    function strip(s) { gsub(/\033\][^\033]*\033\\/, "", s); gsub(/\033\[[0-9;?]*[A-Za-z]/, "", s); return s }
    function trim(t) { gsub(/\302\240/, " ", t); sub(/[ \t]+$/, "", t); return t }
    function isrule(t) { t = trim(t); if (t == "") return 0; gsub(/─/, "", t); return t == "" }
    { plain[NR] = strip($0) }
    END {
      r1 = r2 = 0
      for (i = NR; i >= 1; i--) if (isrule(plain[i])) { if (!r2) r2 = i; else { r1 = i; break } }
      if (!r1 || r2 - r1 < 2 || plain[r1 + 1] !~ /^(❯|>)( |\302\240|$)/) exit
      for (i = 1; i < r1; i++) print trim(plain[i])
    }'
}

# 쉬는 칸 하나가 지금 idle 로 읽히면 0 이고 대화 영역의 지문을 print 에 둔다(pane_state 와 같은 판정 — 다만 기다리지 않고 한 번만 본다).
# 지문은 대화 영역의 cksum — 화면을 못 읽었거나 대화 영역을 못 찾으면 빈 값이다(빈 입력의 cksum 은 늘 같은 값이라 돌리지 않는다).
pane_idle() {
  print=
  pane_state "$1" || return 1
  [ "$st" = idle ] || return 1
  area=$(printf '%s\n' "$shot" | conversation_area)
  [ -n "$area" ] && print=$(printf '%s\n' "$area" | cksum | tr -s ' \t' '-')
  return 0
}

do_sweep() {
  secs=${GW_IDLE_POKE_SECS:-3600}
  cli=$("$here/agent-home" "$aidir" get cli 2>/dev/null) || cli=claude
  [ "$cli" = claude ] || exit 0
  mkdir -p "$state" || exit 1
  # 끝날 때(sweep-loop 가 끝내라고 신호를 보냄) 뒤에서 띄운 poke 도 함께 끝낸다.
  kill_children_on_exit
  now=$(date +%s)
  keys=$("$here/agent-window" --pane-keys "$name" 2>/dev/null) || exit 0
  # 이제 없는 칸의 기록은 지운다 — 같은 키 칸이 나중에 다시 떠도 옛 시각으로 세지 않게.
  for f in "$state"/idle-*; do
    [ -f "$f" ] || continue
    case " $(echo $keys) " in
      *" ${f##*/idle-} "*) ;;
      *) rm -f "$f" ;;
    esac
  done
  for k in $keys; do
    gw_valid_project_key "$k" || continue
    mark="$state/idle-$k"
    if ! pane_idle "$k"; then
      # 쉬는 칸이 아니다 — 일을 하고 있거나 사람이 쓰는 중이다. 센 시간을 버린다(다시 쉬게 되면 그때부터 센다).
      rm -f "$mark"
      continue
    fi
    # 기록은 「<처음 idle 로 본 시각> <화면 지문>」 한 줄이다.
    since= seen=
    read -r since seen 2>/dev/null < "$mark"
    case $since in
      '' | *[!0-9]*) since= ;;
    esac
    if [ -z "$since" ] || [ -z "$print" ] || [ "$seen" != "$print" ]; then
      # 처음 idle 로 봤거나(기록 없음), 지문을 못 얻었거나(빈 지문은 맞은 것으로 치지 않는다), 표본 사이에 화면이 바뀌었다 — 칸이 그 사이
      # 잠깐 일하고 다시 쉰 것이다(5분 표본만으로는 20~30분마다 2~3분 일하는 정상 칸도 늘 idle 로 찍힌다). 지금부터 다시 센다.
      printf '%s %s\n' "$now" "$print" > "$mark"
      continue
    fi
    [ $((now - since)) -ge "$secs" ] || continue
    # 1시간 넘게 쉬었다 — 기존 poke 경로로 넣는다(막 뜬 칸·입력 중 판정·60초 디바운스·잠금을 poke 가 다시 지킨다). 시각은 넣든 못 넣든 지금으로 고쳐
    # 같은 칸을 1시간에 한 번만 건드린다. 칸마다 뒤에서(일하는 칸을 기다리는 사이 다른 칸이 밀리지 않게).
    printf '%s %s\n' "$now" "$print" > "$mark"
    GW_POKE_CLI=$cli "$here/agent-events" poke "$aidir" "$k" </dev/null >/dev/null 2>&1 &
  done
  # 뒤에서 기다려야 신호(TERM)를 바로 받아 poke 를 끝낼 수 있다.
  wait
}

# sweep-loop — run 이 띄우는 주기 점검. GW_IDLE_SWEEP_SEC(기본 300초)마다 sweep 을 부른다. 한 번이 끝난 뒤에 쉬므로 겹치지 않는다.
# run 이 끝나며 신호를 보내면 자기 자식(쉬는 sleep·도는 sweep)을 끝낸다 — sweep 도 같은 방식으로 자기 poke 를 끝낸다(고아가 남지 않게).
do_sweep_loop() {
  kill_children_on_exit
  while :; do
    nap "${GW_IDLE_SWEEP_SEC:-300}"
    # 뒤에서 돌리고 기다린다 — 앞에서 돌리면 끝날 때까지 신호를 받지 못한다.
    "$here/agent-events" sweep "$aidir" </dev/null >/dev/null 2>&1 &
    wait $!
  done
}

do_poke() {
  key=${1:-}
  [ "$key" = - ] || gw_valid_project_key "$key" || usage
  # genia·codex 칸은 실행기가 이미 깨운다 — 실행기 확인이 가장 싸서 먼저 본다. poke - 가 칸마다 부를 때는 읽은 값을 넘겨받는다(GW_POKE_CLI).
  cli=${GW_POKE_CLI:-}
  [ -n "$cli" ] || cli=$("$here/agent-home" "$aidir" get cli 2>/dev/null) || cli=claude
  if [ "$cli" != claude ]; then
    note poke "$key" not-claude
    exit 0
  fi
  if [ "$key" = - ]; then
    # 서버가 불안정하면 다시 붙음이 1~2분마다 온다 — 그때마다 모든 칸에 /loop 를 넣으면 장애 동안 할 일 없는 회차만 쌓인다(WP-1403 리뷰).
    # 다시 붙음 깨우기는 GW_POKE_RECONNECT_SEC(기본 600초)에 한 번만 한다. 마지막으로 깨운 시각(초)을 poke-reconnect 에 적어 비교한다
    # (find -mmin 은 분 단위라 초 간격을 못 맞추고, stat 은 BSD·GNU 가 달라 시각을 파일 내용으로 둔다). 키 알림은 이 간격과 상관없다.
    mkdir -p "$state" || exit 1
    gw_dir_lock "$state/poke-reconnect.lock" || exit 0
    gap=${GW_POKE_RECONNECT_SEC:-600}
    now=$(date +%s)
    last=$(cat "$state/poke-reconnect" 2>/dev/null)
    case $last in
      '' | *[!0-9]*) ;;
      *)
        if [ $((now - last)) -lt "$gap" ]; then
          note poke - debounced
          exit 0
        fi
        ;;
    esac
    printf '%s\n' "$now" > "$state/poke-reconnect"
    # 다시 붙음 — 그 AI 의 칸마다 따로 부른다(키마다 잠그고 디바운스한다). 키가 달린 칸만(--pane-keys — 예전 구성의 창·home·감시 창은 아니다).
    # 칸마다 뒤에서 — 일하는 칸을 기다리는 동안 다른 칸 깨우기가 밀리지 않게. 파이프 끝은 하위 셸이라 그 안에서 기다린다.
    "$here/agent-window" --pane-keys "$name" 2>/dev/null | {
      while IFS= read -r k; do
        gw_valid_project_key "$k" && GW_POKE_CLI=$cli "$here/agent-events" poke "$aidir" "$k" </dev/null >/dev/null 2>&1 &
      done
      wait
    }
    exit 0
  fi
  stamp="$state/poke-$key"
  mkdir -p "$state" || exit 1
  # 같은 키 알림 여럿이 함께 오면 하나만 — 잡지 못하면 다른 쪽이 넣는 중이다.
  # 잡지 못하면 다른 poke 가 넣는 중이거나 쉬기를 기다리는 중이다 — 그쪽이 맡으므로 남기지 않고 끝낸다.
  gw_dir_lock "$state/poke-$key.lock" || exit 0
  # 60초 안에 넣었으면 그 /loop 회차가 아직 돌고 있다 — 몰아친 알림마다 넣지 않는다.
  if [ -n "$(find "$stamp" -mmin -1 2>/dev/null)" ]; then
    note poke "$key" debounced
    exit 0
  fi
  every=${GW_POKE_RETRY_SEC:-15}
  limit=${GW_POKE_RETRY_MAX:-300}
  waited=0
  # 쉬는 칸이 될 때까지 every 초마다 다시 본다(limit 초까지). 칸이 없거나 죽었으면 기다려도 소용없어 바로 끝낸다.
  while :; do
    # 칸 표시 방식은 agent-window 만 안다 — 칸 id·죽음 여부·사람이 보고 있는지를 받는다. 기다리는 사이 칸이 바뀔 수 있어 매번 다시 읽는다.
    # 그 키 칸이 없으면(1) 기록만 남긴다(칸 열기는 open 이 맡는다). tmux·세션이 없으면(3) 아무 칸도 없으니 조용히 끝낸다.
    pane_state "$key"
    case $? in
      0) ;;
      1) note poke "$key" no-pane; exit 0 ;;
      *) exit 0 ;;
    esac
    if [ "$st" = dead ]; then
      note poke "$key" dead
      exit 0
    fi
    [ "$st" = idle ] && break
    if [ "$waited" -ge "$limit" ]; then
      note poke "$key" "$st"
      exit 0
    fi
    sleep "$every"
    waited=$((waited + every))
  done
  queue=$("$here/agent-home" "$aidir" get queue 2>/dev/null) || queue=""
  # 글자와 Enter 를 따로 보낸다 — 한 번에 몰아 보내면 붙여넣기로 읽혀 Enter 가 줄바꿈이 될 수 있다.
  if ! "$tmux" send-keys -t "$pane" -l "/loop /genia-works:work-loop $(gw_loop_args "$key" "$queue")"; then
    note poke "$key" failed
    exit 0
  fi
  sleep 0.3
  if ! "$tmux" send-keys -t "$pane" Enter; then
    note poke "$key" failed
    exit 0
  fi
  : > "$stamp"
  if [ "$waited" -gt 0 ]; then note poke "$key" sent-after-wait; else note poke "$key" sent; fi
  exit 0
}

case "$cmd" in
  ensure) do_ensure ;;
  open) do_open "${3:-}" ;;
  poke) do_poke "${3:-}" ;;
  sweep) do_sweep ;;
  sweep-loop) do_sweep_loop ;;
  run) do_run ;;
  tail) do_tail "${3:-}" ;;
  *) usage ;;
esac
