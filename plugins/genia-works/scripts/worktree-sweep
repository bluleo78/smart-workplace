#!/bin/sh
# work-loop 끝난 이슈 정리 — 이슈가 DONE·CANCELED 된 뒤 그 워크트리·로컬 브랜치·실행 상태 파일을 지운다(WP-1637).
# 이슈 상태는 스킬이 서버(MCP)에서 읽어 판단한다 — 이 스크립트는 서버를 묻지 않는다.
#
#   worktree-sweep list   <MAIN> <프로젝트 키> <AI 이름>
#   worktree-sweep remove <MAIN> <워크트리 경로 | -> <키[,키…]>
#
# list — 정리 후보를 한 줄에 하나, 탭 구분 `<키> <워크트리 경로> <브랜치> <상태>`(워크트리 없는 줄은 경로·브랜치 `-`):
# - MAIN/.claude/worktrees/<프로젝트 키>-<번호> 이슈 워크트리 — 키는 폴더 이름.
# - MAIN/.claude/worktrees/integ-<AI 이름>-<번호> 기차 워크트리(브랜치 integ/…) 중 브랜치 끝이 origin/main 에 들어간 것 — 키는 폴더 이름.
# - 워크트리 없이 남은 notes(MAIN/.work-loop/state/notes/<프로젝트 키>-<번호>.md · integ-<AI 이름>-<번호>.md).
# 상태(여럿이면 앞의 것): locked(git worktree lock) · running(bg-job 이 running) · unpushed(올리지 않은 커밋) ·
#   dirty(커밋 안 한 변경 — git 무시 파일은 세지 않는다) · ok(지워도 됨) · notes-only
# remove — 지우면 `removed <경로>`(- 면 `removed - <키들>`), 남기면 `kept <경로>: <이유>`.
#
# 종료 코드: 0 = 성공 · 2 = 사용법 오류·등록 안 된 워크트리·git 이 지우기를 거절함 · 3 = 남김(list 의 ok 가 아닌 이유가 생김)
here=$(cd "$(dirname "$0")" && pwd)
. "$here/gw-lib.sh"

usage() {
  echo "사용법: worktree-sweep list <MAIN> <프로젝트 키> <AI 이름> | remove <MAIN> <워크트리 경로|-> <키[,키…]>" >&2
  exit 2
}

[ $# -ge 2 ] || usage
_ws_cmd=$1 _ws_main=$2
[ -d "$_ws_main" ] || { echo "MAIN 폴더가 없습니다: $_ws_main" >&2; exit 2; }
# remove 의 상대 경로는 부른 곳 기준이다 — MAIN 으로 옮기기 전에 적어 둔다. CDPATH 가 cd 를 엉뚱한 곳으로 보내지 않게 끈다.
unset CDPATH
_ws_cwd=$(pwd 2>/dev/null) || _ws_cwd=/
# 부른 곳이 지울 워크트리 안이어도 그 폴더를 쥐고 있지 않게 MAIN 으로 옮긴다.
cd "$_ws_main" || exit 2
_ws_main=$(pwd)
_ws_state="$_ws_main/.work-loop/state"
_ws_bg=$here/bg-job
_ws_tab=$(printf '\t')

# 원격 기본 브랜치(origin/HEAD, 없으면 origin/main)의 ref — 부를 때 한 번만 구한다. 없으면 빈 값.
if _ws_base=$(git -C "$_ws_main" symbolic-ref -q refs/remotes/origin/HEAD 2>/dev/null); then
  :
elif git -C "$_ws_main" rev-parse -q --verify refs/remotes/origin/main >/dev/null; then
  _ws_base=refs/remotes/origin/main
else
  _ws_base=""
fi

# MAIN/.claude/worktrees/ 바로 아래의 워크트리를 한 줄에 하나 "<경로>\t<브랜치 또는 ->\t<locked|->" 로 낸다.
# git 이 적은 경로는 MAIN 을 부른 모양(심볼릭 링크 포함)이나 실제 경로일 수 있어 두 앞머리를 모두 받는다.
ws_worktrees() {
  git -C "$_ws_main" worktree list --porcelain | awk -v a="$_ws_main/.claude/worktrees/" -v b="$(pwd -P)/.claude/worktrees/" '
    function flush(  n) {
      n = ""
      if (p != "" && index(p, a) == 1) n = substr(p, length(a) + 1)
      else if (p != "" && index(p, b) == 1) n = substr(p, length(b) + 1)
      if (n != "" && n !~ /\//) print p "\t" (br == "" ? "-" : br) "\t" (lk ? "locked" : "-")
      p = ""; br = ""; lk = 0
    }
    /^worktree / { flush(); p = substr($0, 10) }
    /^branch / { br = substr($0, 8); sub(/^refs\/heads\//, "", br) }
    /^locked/ { lk = 1 }
    END { flush() }'
}

# 이 프로젝트의 이슈 키(<프로젝트 키>-<번호>)면 0.
ws_my_issue() {
  gw_valid_issue_key "$1" && [ "${1%-*}" = "$_ws_proj" ]
}

# 내 기차 이름(integ-<AI 이름>-<번호>)이면 0. 끝이 번호뿐이어야 한다 — AI dev 가 dev-x 의 기차(integ-dev-x-1)를 잡지 않게.
ws_my_train() {
  case "$1" in "integ-$_ws_ai-"*) ;; *) return 1 ;; esac
  case "${1#"integ-$_ws_ai-"}" in '' | *[!0-9]*) return 1 ;; esac
  return 0
}

# 올리지 않은 커밋 수를 낸다 — $1(ref·SHA)에서 어느 원격 ref 에도 없고 origin/main 에 같은 patch 로도 없는 커밋.
# 기차 흐름의 feature 브랜치는 push 하지 않고 커밋을 기차에 cherry-pick 해 머지하므로 patch 가 같으면(git cherry 의 `-`) 올라간 것으로 본다.
# merge 커밋은 git cherry 가 내지 않아 세지 않는다(origin/main 을 당겨 온 merge 로 영영 남기지 않게).
# 견줄 수 없으면 지우지 않는 쪽으로 — rev-list 가 실패하면 `?`, 기준이 없거나 cherry 가 실패하면 원격에 없는 커밋을 모두 센다.
ws_unpushed() {
  _ws_un=$(git -C "$_ws_main" rev-list "$1" --not --remotes 2>/dev/null) || { echo '?'; return; }
  [ -n "$_ws_un" ] || { echo 0; return; }
  if [ -n "$_ws_base" ] && _ws_ch=$(git -C "$_ws_main" cherry "$_ws_base" "$1" 2>/dev/null); then
    _ws_plus=$(printf '%s\n' "$_ws_ch" | sed -n 's/^+ //p')
    [ -n "$_ws_plus" ] || { echo 0; return; }
    # 원격 어딘가에 있는 커밋(push 한 feature 브랜치)은 빼고 센다.
    printf '%s\n' "$_ws_un" | grep -cxF "$_ws_plus"
  else
    printf '%s\n' "$_ws_un" | wc -l | tr -d ' '
  fi
}

# 워크트리(경로 $1, 브랜치 $2 또는 -)의 올리지 않은 커밋 수. 브랜치가 없으면 폴더가 있을 때 그 HEAD 를 본다.
ws_wt_unpushed() {
  if [ "$2" != - ]; then
    ws_unpushed "refs/heads/$2"
  elif [ -d "$1" ] && _ws_h=$(git -C "$1" rev-parse -q --verify HEAD 2>/dev/null); then
    ws_unpushed "$_ws_h"
  else
    echo 0
  fi
}

# 커밋 안 한 변경 수를 낸다. 폴더가 없으면(손으로 지움) 0, status 가 실패하면 지우지 않게 `?`.
ws_dirty() {
  [ -d "$1" ] || { echo 0; return; }
  _ws_st=$(git -C "$1" status --porcelain 2>/dev/null) || { echo '?'; return; }
  [ -n "$_ws_st" ] || { echo 0; return; }
  printf '%s\n' "$_ws_st" | wc -l | tr -d ' '
}

# 키(공백으로 이은) 중 하나라도 bg-job 이 running 이면 0.
# bg-job 은 exit 파일이 있으면 끝남, pid 파일이 없으면 none 이다 — 그때는 bg-job 을 부르지 않는다.
# 기차는 첫 이슈 키로 게이트를 띄우지만 기차 키(integ-…)만 본다 — main 에 들어간 기차는 게이트를 돌릴 이유가 없다.
ws_any_running() {
  for _ws_k in $1; do
    [ -f "$_ws_state/jobs/$_ws_k.pid" ] && [ ! -f "$_ws_state/jobs/$_ws_k.exit" ] || continue
    [ "$("$_ws_bg" status "$_ws_main" "$_ws_k" 2>/dev/null)" = running ] && return 0
  done
  return 1
}

# 남길 이유를 본다 — 경로 $1(없으면 빈 값)·브랜치 $2·잠김 $3·키들 $4(공백).
# list 의 상태와 remove 의 남김이 같은 순서(locked > running > unpushed > dirty)를 쓰도록 여기 한곳에 둔다.
# _ws_st 에 상태, _ws_why 에 이유를 두고, 남기면 0·ok 면 1.
ws_keep() {
  _ws_why=""
  if [ "$3" = locked ]; then
    _ws_st=locked _ws_why="잠긴 워크트리(git worktree lock)"
  elif ws_any_running "$4"; then
    _ws_st=running _ws_why="백그라운드 작업 도는 중"
  elif [ -n "$1" ] && _ws_n=$(ws_wt_unpushed "$1" "$2") && [ "$_ws_n" != 0 ]; then
    _ws_st=unpushed _ws_why="올리지 않은 커밋 ${_ws_n}개"
  elif [ -n "$1" ] && _ws_n=$(ws_dirty "$1") && [ "$_ws_n" != 0 ]; then
    _ws_st=dirty _ws_why="커밋 안 한 변경 ${_ws_n}개"
  else
    _ws_st=ok
    return 1
  fi
  return 0
}

# 경로를 글자로만 정리한다 — 겹친 /·`.`·`..`·끝 / 를 없앤다(폴더가 없어 실제 경로를 못 구할 때).
ws_textual() {
  printf '%s\n' "$1" | awk -F/ '{
    n = 0
    for (i = 1; i <= NF; i++) {
      if ($i == "" || $i == ".") continue
      if ($i == "..") { if (n > 0) n--; continue }
      st[++n] = $i
    }
    o = ""
    for (i = 1; i <= n; i++) o = o "/" st[i]
    print (o == "" ? "/" : o)
  }'
}

# 절대·정규 경로를 낸다. 상대 경로는 부른 곳 기준. 폴더가 있으면 실제 경로(심볼릭 링크 풂),
# 없으면 글자로 정리한 뒤 부모의 실제 경로 + 끝 이름, 부모도 없으면 글자로 정리한 그대로.
ws_abs() {
  case "$1" in /*) _ws_a=$1 ;; *) _ws_a="$_ws_cwd/$1" ;; esac
  if [ -d "$_ws_a" ] && _ws_r=$(gw_real_dir "$_ws_a" 2>/dev/null); then
    printf '%s\n' "$_ws_r"
    return 0
  fi
  _ws_a=$(ws_textual "$_ws_a")
  _ws_d=${_ws_a%/*}
  [ -n "$_ws_d" ] || _ws_d=/
  if [ -d "$_ws_d" ] && _ws_r=$(gw_real_dir "$_ws_d" 2>/dev/null); then
    printf '%s/%s\n' "${_ws_r%/}" "${_ws_a##*/}"
    return 0
  fi
  printf '%s\n' "$_ws_a"
}

cmd_list() {
  # 워크트리에 걸린 이름 — notes-only 를 가를 때 쓴다(앞뒤 공백으로 WP-37 과 WP-377 을 나눈다).
  # 줄로 내지 않는 기차(아직 안 들어감)도 넣는다 — 그 notes 는 아직 쓰는 중이다.
  _ws_have=" "
  _ws_list=$(ws_worktrees) || exit 2
  while IFS="$_ws_tab" read -r _ws_path _ws_branch _ws_lock; do
    [ -n "$_ws_path" ] || continue
    _ws_name=${_ws_path##*/}
    _ws_have="$_ws_have$_ws_name "
    case "$_ws_branch" in
      integ/*)
        ws_my_train "$_ws_name" || continue
        # 머지된 기차로는 돌아오지 않는다(고칠 것은 새 브랜치·다음 기차로) — 들어간 기차만 낸다.
        [ -n "$_ws_base" ] && git -C "$_ws_main" merge-base --is-ancestor "refs/heads/$_ws_branch" "$_ws_base" 2>/dev/null || continue
        ;;
      *)
        # 기획 워크트리(<키>-plan)는 이름이 이슈 키가 아니라 여기서 빠진다 — 기획 넘기기(plan-issue.md)가 지운다.
        ws_my_issue "$_ws_name" || continue
        ;;
    esac
    ws_keep "$_ws_path" "$_ws_branch" "$_ws_lock" "$_ws_name"
    printf '%s\t%s\t%s\t%s\n' "$_ws_name" "$_ws_path" "$_ws_branch" "$_ws_st"
  done <<EOF
$_ws_list
EOF
  for _ws_f in "$_ws_state/notes/"*.md; do
    [ -f "$_ws_f" ] || continue
    _ws_n=${_ws_f##*/}
    _ws_n=${_ws_n%.md}
    ws_my_issue "$_ws_n" || ws_my_train "$_ws_n" || continue
    case "$_ws_have" in *" $_ws_n "*) continue ;; esac
    printf '%s\t-\t-\tnotes-only\n' "$_ws_n"
  done
}

cmd_remove() {
  _ws_target=$1
  # 키는 파일 이름으로 쓰므로 경로 조작을 막는다. 검사를 통과한 키에는 공백·glob 문자가 없어 공백으로 나눠 그대로 돈다.
  case ",$2," in *,,*) usage ;; esac
  _ws_keys=$(printf '%s' "$2" | tr , ' ')
  for _ws_k in $_ws_keys; do
    gw_valid_name "$_ws_k" || usage
  done

  _ws_path="" _ws_branch=- _ws_lock=-
  if [ "$_ws_target" != - ]; then
    # 받은 경로를 절대·정규 경로로 바꿔, MAIN/.claude/worktrees/ 바로 아래에 등록된 워크트리 경로와 정확히 같을 때만 받는다(끝 이름만 맞추지 않는다).
    _ws_want=$(ws_abs "$_ws_target")
    _ws_root=$(ws_abs "$_ws_main/.claude/worktrees")
    _ws_list=$(ws_worktrees) || exit 2
    while IFS="$_ws_tab" read -r _ws_p _ws_b _ws_l; do
      [ -n "$_ws_p" ] || continue
      _ws_rp=$(ws_abs "$_ws_p")
      [ "$_ws_rp" = "$_ws_want" ] || continue
      [ "${_ws_rp%/*}" = "$_ws_root" ] || continue
      _ws_path=$_ws_p _ws_branch=$_ws_b _ws_lock=$_ws_l
    done <<EOF
$_ws_list
EOF
    [ -n "$_ws_path" ] || { echo "MAIN/.claude/worktrees/ 에 등록된 워크트리가 아닙니다: $_ws_target" >&2; exit 2; }
  fi

  # 남길 이유는 bg-job 파일을 건드리기 전에 본다 — 남길 때는 아무것도 바꾸지 않는다. 돌고 있는 작업은 끄지 않는다.
  ws_keep "$_ws_path" "$_ws_branch" "$_ws_lock" "$_ws_keys" && { echo "kept $_ws_target: $_ws_why"; exit 3; }

  # 끝난 작업 파일을 지운다 — clear 는 돌고 있으면 거절하므로, 위 검사 뒤에 작업이 떴으면 아무것도 지우지 않고 남긴다.
  for _ws_k in $_ws_keys; do
    "$_ws_bg" clear "$_ws_main" "$_ws_k" >/dev/null || { echo "kept $_ws_target: 백그라운드 작업 도는 중"; exit 3; }
  done

  if [ -n "$_ws_path" ]; then
    if [ -d "$_ws_path" ]; then
      # --force 없이 — 커밋 안 한 변경은 위에서 걸렀고, git 무시 파일(node_modules 등)만 있으면 git 이 그대로 지운다.
      git -C "$_ws_main" worktree remove "$_ws_path" >&2 || { echo "kept $_ws_target: git worktree remove 가 거절했다"; exit 2; }
    else
      # 폴더를 손으로 지웠으면 등록만 남았다 — 그 등록 하나만 지운다(전역 `git worktree prune` 은 다른 워크트리 등록까지 지운다).
      git -C "$_ws_main" worktree remove --force "$_ws_path" >&2 || { echo "kept $_ws_target: 손으로 지운 워크트리의 등록을 지우지 못했다"; exit 2; }
    fi
    # -D — 호스트에서 머지돼 로컬 main 에 없으니 -d 는 거절된다. 올리지 않은 커밋은 위에서 걸렀다. 원격 브랜치는 지우지 않는다.
    if [ "$_ws_branch" != - ]; then
      git -C "$_ws_main" branch -D "$_ws_branch" >/dev/null 2>&1 \
        || echo "worktree-sweep: 브랜치 $_ws_branch 를 지우지 못했다(다른 워크트리에서 쓰는 중일 수 있다)" >&2
    fi
  fi

  for _ws_k in $_ws_keys; do
    rm -f "$_ws_state/notes/$_ws_k.md" "$_ws_state/seen/$_ws_k"
    rm -rf "$_ws_state/evidence/$_ws_k"
  done

  if [ -n "$_ws_path" ]; then
    echo "removed $_ws_target"
  else
    echo "removed - $2"
  fi
}

case "$_ws_cmd" in
  list)
    [ $# -eq 4 ] || usage
    _ws_proj=$3 _ws_ai=$4
    gw_valid_project_key "$_ws_proj" || usage
    gw_valid_name "$_ws_ai" || usage
    cmd_list
    ;;
  remove)
    [ $# -eq 4 ] || usage
    cmd_remove "$3" "$4"
    ;;
  *)
    usage
    ;;
esac
