#!/bin/sh
# gw-models < models.json — Works 가 띄운 AI 가 자기 프로그램이 쓸 수 있는 모델 목록을 보고한다(PUT /agent-runtime/me/models, WP-1297).
# 표준 입력은 {"models":[{"id":"gpt-6-luna","label":"GPT-6-Luna","efforts":["low","medium","high"]}, …]} 한 덩어리(JSON)다.
# 왜: ChatGPT 로그인 계정은 refresh token 이 1회용이라 Works 서버가 저장된 로그인으로 모델 목록을 조회하면 Pod 안 프로그램의 로그인이 풀린다.
#   그래서 목록은 Pod 안에서(예: `codex debug models`) 뽑아 이 스크립트로 보고하고, 관리자 화면의 「모델」 칸이 그 보고를 받아 쓴다.
# - GENIA_AGENT_GENERATION(runner 가 Pod 에 넣는 generation)이 없으면 Works 가 띄운 AI 가 아니다 — 서버에 보내지 않고 조용히 끝낸다.
# - GENIA_LOGIN_VERSION(Pod 가 받은 로그인 정보의 version = 연결 id)이 없으면 로그인이 없다 — 보고할 목록이 의미 없어 조용히 끝낸다.
#   있으면 본문에 "loginVersion" 으로 덧붙여 보낸다 — 서버는 그것이 지금 활성 연결 id 와 같을 때만 저장한다(관리자가 로그인을 바꾼 직후 옛 Pod 의
#   보고가 새 연결의 목록으로 저장되는 것을 막는다). 표준 입력 {"models":[…]} 모양은 그대로이고 jq 로 덧붙인다(gw-agent-projects·gw-repo 와 같은 의존).
# - 보고는 최선 노력이다: 실패해도(키 없음·서버 오류·닿지 못함·입력 이상) 일을 막지 않고 표준 오류에 한 줄만 알린 뒤 늘 종료 0.
# - 성공하면 아무것도 출력하지 않는다(서버는 204). 서버는 활성 연결이 로그인 계정이 아니면 저장 없이 204 로 무시한다.
# 키·서버 주소·워크스페이스는 gw-status 와 같은 방식(gw_identity_key·gw_api_url·GENIA_WORKS_TENANT)으로 읽는다.
# 키는 명령줄 인자로 넘기지 않고(ps 에 보인다) 표준 입력으로 curl 설정에 넣으며, 어디에도 출력하지 않는다. 본문(모델 목록)에는 비밀이 없다.
here=$(cd "$(dirname "$0")" && pwd)
. "$here/gw-lib.sh"

# 실패해도 일은 계속한다 — 경고 한 줄과 종료 0.
fallback() {
  echo "gw-models: $1 — 보고하지 않고 계속합니다" >&2
  exit 0
}

# Works 가 띄운 AI 가 아니면(generation 없음) 로그인이 없으면(version 없음) 보낼 것이 없다 — 조용히 끝낸다. generation 은 서버에 보내지 않아 값은 보지 않는다.
[ -n "${GENIA_AGENT_GENERATION:-}" ] || exit 0
ver="${GENIA_LOGIN_VERSION:-}"
[ -n "$ver" ] || exit 0
case "$ver" in *[!0-9]*) fallback "GENIA_LOGIN_VERSION 이 숫자가 아닙니다" ;; esac

# 표준 입력의 JSON 객체에 loginVersion 을 덧붙인다(입력에 같은 키가 있어도 이 값으로 덮는다). jq 가 없거나 객체가 아니면 실패해 보내지 않는다 —
# 성공한 출력은 항상 '{' 로 시작하는 한 줄 JSON 이라 curl -d 가 '@' 로 파일을 읽을 일이 없다.
# -s 로 한 덩어리로 받아 JSON 문서가 정확히 하나일 때만 통과시킨다(여러 문서를 이어 붙인 입력이 여러 줄 본문이 되지 않게).
body=$(jq -cs --argjson v "$ver" 'if length == 1 and (.[0] | type) == "object" then .[0] + {loginVersion: $v} else error("object") end' 2>/dev/null) ||
  fallback "표준 입력이 JSON 객체가 아니거나 jq 가 없습니다"
# 빈 입력은 jq 가 아무것도 내지 않고 성공하므로 따로 막는다.
[ -n "$body" ] || fallback "표준 입력이 비어 있습니다"
# 모델 100개 상한 안의 정상 보고는 수십 KB 를 넘지 않는다 — 터무니없이 크면 보내지 않는다. 본문은 curl 인자 한 개(-d)로 가는데 리눅스는 인자 하나를
# 128KiB 까지만 받으므로(넘으면 curl 이 실행되지 않는다) 실제로 보낼 본문의 크기를 글자 수가 아닌 바이트로 100000 상한을 둔다.
[ "$(printf '%s' "$body" | wc -c | tr -d ' ')" -le 100000 ] || fallback "본문이 너무 큽니다"

key=$(gw_identity_key) || key=""
[ -n "$key" ] || fallback "AI 키 신원이 아니어서 보고하지 않았습니다"

gw_api_request "$key" 5 15 -X PUT -H 'Content-Type: application/json' -d "$body" \
  "$(gw_api_url)/agent-runtime/me/models"
[ "$GW_CODE" = 204 ] || [ "$GW_CODE" = 200 ] || fallback "모델 목록 보고 실패(HTTP ${GW_CODE:-000})"
exit 0
