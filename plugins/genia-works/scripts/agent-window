#!/bin/sh
# agent-window <tmux 세션> <창 이름> <작업 폴더> <명령> [인자…] — tmux 세션(없으면 만든다)에 이름 붙은 창을 하나 띄워 명령을 돌린다(WP-1011).
# start-agent 가 프로젝트마다 work-loop 세션을 띄우는 데 쓴다. 결과를 한 줄로 낸다(<세션> 은 tmux 가 실제로 쓰는 이름 — attach 할 때 그대로):
#   started <세션> — 새 창을 띄웠다
#   exists <세션>  — 같은 이름의 창이 이미 있다(다시 부르면 새로 연결된 프로젝트만 더 띄우려는 것 — 돌던 창은 건드리지 않는다)
#   no-tmux   — tmux 가 없다(종료 코드 3)
# 명령은 셸을 거치지 않고 인자 그대로 넘긴다(tmux 3.0+) — 대기열 라벨처럼 공백·한글이 든 인자도 따옴표 없이 그대로 간다.
if [ $# -lt 4 ]; then
  echo "사용: agent-window <tmux 세션> <창 이름> <작업 폴더> <명령> [인자…]" >&2
  exit 2
fi
# tmux 는 세션·창 이름의 . 과 : 를 _ 로 바꿔 저장한다 — 미리 바꿔 두어야 다시 부를 때 has-session·창 찾기가 맞는다.
session=$(printf '%s' "$1" | tr '.:' '__')
window=$(printf '%s' "$2" | tr '.:' '__')
dir=$3
shift 3
# GW_TMUX 는 테스트 전용 훅(가짜 tmux) — 운영에서는 설정하지 않는다.
tmux=${GW_TMUX:-tmux}

if ! command -v "$tmux" >/dev/null 2>&1; then
  echo no-tmux
  exit 3
fi

if ! "$tmux" has-session -t "=$session" 2>/dev/null; then
  # 첫 창은 안내용 빈 셸(홈 폴더) — 프로젝트 창을 닫아도 세션이 남게.
  "$tmux" new-session -d -s "$session" -n home -c "$PWD" || exit 1
fi

if "$tmux" list-windows -t "=$session" -F '#W' 2>/dev/null | grep -qxF -- "$window"; then
  echo "exists $session"
  exit 0
fi

# 새 창은 이 셸이 아니라 이미 떠 있는 tmux 서버의 환경을 물려받는다 — 서버를 다른 셸에서 띄웠으면 claude·gh 가 PATH 에 없을 수 있어
# 이 셸의 PATH 를 넘긴다.
"$tmux" new-window -d -t "=$session:" -n "$window" -c "$dir" env "PATH=$PATH" "$@" || exit 1
echo "started $session"
