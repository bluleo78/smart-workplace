#!/bin/sh
# agent-window [--restart] <tmux 세션> <프로젝트 키> <작업 폴더> <명령> [인자…] — AI 의 tmux 세션에 프로젝트 칸 하나를 띄워 명령을 돌린다(WP-1011).
# start-agent 가 프로젝트마다 work-loop 세션을 띄우는 데 쓴다. AI 하나 = tmux 세션 하나 = 창(work) 하나이고 프로젝트마다 칸 하나다(WP-1053) —
# 붙으면 맡은 프로젝트가 한 화면에 다 보이고, 클릭(마우스)으로 칸을 골라 직접 묻거나 칠 수 있다.
# 칸은 칸 사용자 옵션 @gw_key 로 찾는다 — Claude 가 터미널 제목을 바꿔도 남고, 칸 위 테두리에 그 키를 보인다.
# 결과를 한 줄로 낸다(<세션> 은 tmux 가 실제로 쓰는 이름 — attach 할 때 그대로):
#   started <세션>   — 새 칸을 띄웠다
#   exists <세션>    — 그 프로젝트 칸이 돌고 있어 건드리지 않았다(다시 부르면 새로 연결된 프로젝트만 더 띄우려는 것)
#   revived <세션>   — 그 칸의 명령이 끝나 있어(죽은 칸 — remain-on-exit 로 남겨 둔다) 그 자리에서 다시 띄웠다
#   restarted <세션> — --restart 라 돌던 칸을 끝내고 다시 띄웠다(WP-1046 — /loop 반복은 7일 뒤 끝나 다시 걸어야 한다)
#   legacy <세션>    — 예전 구성(프로젝트마다 창)이라 건드리지 않았다 — --restart 로 부르면 칸으로 옮기고 그 옛 창을 닫는다
#   no-tmux          — tmux 가 없다(종료 코드 3)
# agent-window --keys <tmux 세션> — 그 세션의 칸마다 한 줄: 키가 달린 칸은 프로젝트 키, 키 없는 칸은 창 이름(예전 구성의 프로젝트 창·home).
#   세션이 없으면 3. 칸을 어떻게 표시하는지는 이 스크립트만 안다 — agent-home(새 프로젝트 확인)·start-agent(남은 칸 찾기)가 이것으로 읽는다.
# agent-window --paths <tmux 세션> — 칸마다 그 칸이 지금 있는 폴더 한 줄(agent-project locate 가 예전에 띄운 AI 의 홈을 찾는 데 쓴다). 세션이 없으면 3.
# 명령은 셸을 거치지 않고 인자 그대로 넘긴다(tmux 3.0+) — 대기열 라벨처럼 공백·한글이 든 인자도 따옴표 없이 그대로 간다.
here=$(cd "$(dirname "$0")" && pwd)
. "$here/gw-lib.sh"
# GW_TMUX 는 테스트 전용 훅(격리한 tmux 서버) — 운영에서는 설정하지 않는다.
tmux=${GW_TMUX:-tmux}
# tmux 는 세션·창 이름의 . 과 : 를 _ 로 바꿔 저장한다 — 미리 바꿔 두어야 다시 부를 때 세션·칸 찾기가 맞는다.
tmux_name() { printf '%s' "$1" | tr '.:' '__'; }

if [ "${1:-}" = --keys ] || [ "${1:-}" = --paths ]; then
  [ $# -eq 2 ] || { echo "사용: agent-window --keys|--paths <tmux 세션>" >&2; exit 2; }
  if [ "$1" = --keys ]; then format='#{?@gw_key,#{@gw_key},#W}'; else format='#{pane_current_path}'; fi
  "$tmux" list-panes -s -t "=$(tmux_name "$2")" -F "$format" 2>/dev/null || exit 3
  exit 0
fi

restart=0
if [ "${1:-}" = --restart ]; then
  restart=1
  shift
fi
if [ $# -lt 4 ]; then
  echo "사용: agent-window [--restart] <tmux 세션> <프로젝트 키> <작업 폴더> <명령> [인자…]" >&2
  exit 2
fi
session=$(tmux_name "$1")
key=$(tmux_name "$2")
dir=$3
shift 3
win=work

if ! command -v "$tmux" >/dev/null 2>&1; then
  echo no-tmux
  exit 3
fi

# 같은 세션을 동시에 다루면(start-agent 와 돌고 있는 칸이 새 프로젝트를 함께 띄우는 등) 둘 다 칸을 못 찾고 둘 다 나눌 수 있다 —
# 세션마다 잠그고 차례로 한다. 한 번은 1초도 안 걸리므로 10초까지 기다린다.
if ! gw_dir_lock "${TMPDIR:-/tmp}/gw-agent-window-$(id -u)-$session.lock" 100; then
  echo "agent-window: $session 세션을 다른 쪽이 다루고 있습니다" >&2
  exit 1
fi

# 새 칸은 이 셸이 아니라 이미 떠 있는 tmux 서버의 환경을 물려받는다 — 서버를 다른 셸에서 띄웠으면 claude·gh 가 PATH 에 없을 수 있어
# 이 셸의 PATH 를 넘긴다(다시 띄울 때도 같다).
set -- env "PATH=$PATH" "$@"

# 새로 만든 창의 설정 — 칸 위 테두리에 프로젝트 키, 명령이 끝난 칸은 닫지 않고 남겨(죽은 칸) 보이게 한다. 마우스는 이 세션에만 켠다.
setup() {
  "$tmux" set-option -t "=$session:" mouse on >/dev/null &&
    "$tmux" set-option -w -t "$1" remain-on-exit on >/dev/null &&
    "$tmux" set-option -w -t "$1" pane-border-status top >/dev/null &&
    "$tmux" set-option -w -t "$1" pane-border-format ' #{@gw_key} ' >/dev/null || exit 1
}

# 칸·창은 자리 잡기 명령(cat — 입력을 기다리며 그대로 있다)으로 먼저 만들고, 키를 달고 설정을 건 뒤 진짜 명령으로 바꿔 띄운다 —
# 명령이 곧바로 끝나도(claude 실행 실패 등) 칸이 사라지지 않고 죽은 칸으로 남아, 다음 부르기가 그 칸을 찾아 revived 로 다시 띄운다.
# new_pane <tmux 명령과 인자…> — 새 세션·창을 자리 잡기 명령으로 만들고 설정을 건다(pane 에 칸 id).
new_pane() {
  pane=$("$tmux" "$@" -c "$dir" -P -F '#{pane_id}' cat) || exit 1
  setup "$pane"
}
# run_in <칸> — 그 칸에 키를 달고 안의 명령을 끝내고 진짜 명령으로 다시 띄운다(-k).
run_in() {
  pane=$1
  shift
  "$tmux" set-option -p -t "$pane" @gw_key "$key" && "$tmux" respawn-pane -k -t "$pane" -c "$dir" "$@" || exit 1
}

# 그 프로젝트 칸 찾기 — 세션의 모든 창에서(사람이 칸을 다른 창으로 옮겼거나, 자리가 모자라 따로 창을 띄웠어도 찾게). 실패하면 세션이 없다.
if ! listing=$("$tmux" list-panes -s -t "=$session" -F '#{pane_id} #{pane_dead} #{@gw_key}' 2>/dev/null); then
  # 붙은 사람이 없는 세션은 80x24 로 만들어져 칸을 몇 번 나누면 자리가 모자란다 — 넉넉히 만들고, 붙으면 그 화면 크기로 바뀐다.
  new_pane new-session -d -s "$session" -n "$win" -x 240 -y 60
  run_in "$pane" "$@"
  echo "started $session"
  exit 0
fi
found=$(printf '%s\n' "$listing" | awk -v k="$key" '$3 == k { print $1, $2; exit }')
if [ -n "$found" ]; then
  dead=${found#* }
  if [ "$restart" = 0 ] && [ "$dead" != 1 ]; then
    echo "exists $session"
    exit 0
  fi
  # 칸은 그 자리에 두고 안의 명령만 다시 띄운다 — claude 가 끝나므로 하던 일은 새 세션의 work-loop 가 다음 확인에서 이어 받는다.
  run_in "${found% *}" "$@"
  if [ "$restart" = 1 ]; then echo "restarted $session"; else echo "revived $session"; fi
  exit 0
fi

# 예전 구성(프로젝트마다 창 — 0.1.22 이하)인지 — 그 프로젝트 이름의 창이 있거나, home 창만 있고 work 창이 아직 없으면.
# 돌던 창 옆에 칸을 말없이 늘어놓으면 같은 clone 에 work-loop 가 둘이 되므로, --restart 때만 옮기고 그 옛 창을 닫는다.
# home 창은 닫지 않는다 — 사람이 그 창에서 이 start-agent 를 돌리고 있을 수 있다.
windows=$("$tmux" list-windows -t "=$session" -F '#{window_id} #W' 2>/dev/null)
old=$(printf '%s\n' "$windows" | awk -v k="$key" '$2 == k { print $1; exit }')
has_win=$(printf '%s\n' "$windows" | awk -v w="$win" '$2 == w { f = 1 } END { print f + 0 }')
has_home=$(printf '%s\n' "$windows" | awk '$2 == "home" { f = 1 } END { print f + 0 }')
if [ "$restart" = 0 ] && { [ -n "$old" ] || [ "$has_home$has_win" = 10 ]; }; then
  echo "legacy $session"
  exit 0
fi

if [ "$has_win" = 1 ]; then
  # 나누기 전에 고르게 펴 두어야 작은 칸을 또 나누다 자리가 모자라지 않는다.
  "$tmux" select-layout -t "=$session:=$win" tiled >/dev/null 2>&1
  if pane=$("$tmux" split-window -d -t "=$session:=$win" -c "$dir" -P -F '#{pane_id}' cat 2>/dev/null); then
    "$tmux" select-layout -t "=$session:=$win" tiled >/dev/null 2>&1
  else
    # 붙은 화면이 작아 더 나눌 자리가 없다 — 그 프로젝트만 따로 창을 띄운다(칸 키로 찾으므로 다음 부르기도 그 칸을 찾는다).
    new_pane new-window -d -t "=$session:" -n "$key"
  fi
else
  new_pane new-window -d -t "=$session:" -n "$win"
fi
run_in "$pane" "$@"

if [ "$restart" = 1 ]; then
  # 예전 구성에서 옮기는 중 — 그 프로젝트의 옛 창을 닫고(새 칸을 띄운 뒤라 세션이 비지 않는다) work 창을 앞에 둔다.
  [ -n "$old" ] && "$tmux" kill-window -t "$old" 2>/dev/null
  "$tmux" select-window -t "=$session:=$win" 2>/dev/null
fi
echo "started $session"
