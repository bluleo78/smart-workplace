#!/bin/sh
# work-loop 백그라운드 작업 — 오래 걸리는 명령(push 게이트 등)을 세션과 떨어뜨려 띄우고, 다음 부르기에서 결과를 본다(WP-994).
#
#   bg-job start  <MAIN> <이슈 키> <작업 폴더> -- <명령> [인자…]   # 띄우면 "started <pid>", 이미 돌고 있으면 "running" 으로 exit 1
#   bg-job status <MAIN> <이슈 키>                                  # running | passed | failed <코드> | lost | none
#   bg-job clear  <MAIN> <이슈 키>                                  # 끝난 작업의 파일을 지운다 — 돌고 있으면 "running" 으로 exit 1
#   bg-job stop   <MAIN> <이슈 키>                                  # 돌고 있는 작업을 프로세스 그룹째 끝내고 파일을 지운다 — "ok", 끝내지 못하면 exit 2
#
# 종료 코드: 0 = 성공(status 는 상태와 상관없이 0) · 1 = 이미 실행 중 · 2 = 사용법 오류·파일을 못 씀·띄우지 못함·(stop) 끝내지 못함
#
# 파일은 MAIN/.work-loop/state/jobs/<이슈 키>.{log,exit,pid,dir}:
# - log  : 명령의 표준 출력·오류(띄울 때마다 새로 쓴다)
# - exit : 명령이 끝나면 종료 코드 한 줄 — 임시 파일에 쓰고 mv 해 반쯤 쓴 값을 읽지 않게 한다
# - pid  : 띄운 셸의 "<pid>-<시작 시각>"(gw_proc_key). pid 는 다시 쓰이므로 시작 시각까지 맞아야 같은 작업으로 본다.
#          띄울 때 시작 시각을 못 읽었으면 "<pid>-" 로 남기고, 그때는 pid 가 살아 있는지만 본다(stop 은 그 pid 에 직접 신호를 보내지 않고 그룹에만)
# - dir  : 작업 폴더의 실제 경로(gw_real_dir) 한 줄 — 워크트리 정리(worktree-sweep ws_any_running)가 작업을 폴더로 가른다(WP-1637)
# 작업은 새 세션(setsid — macOS 는 perl POSIX::setsid)으로 띄운다. 부른 Bash 도구·claude 세션의 프로세스 그룹과 떨어져
# 그쪽이 끝나도 같이 죽지 않고, 띄운 셸이 그룹 대표라 stop 이 명령의 자식(E2E·gradle)까지 함께 끝낸다.
# start 는 띄운 자식이 새 세션의 대표가 된 뒤에 started 를 낸다 — 그 전에 stop 이 오면 아직 없는 그룹에 신호를 보내 작업이 남기 때문이다(WP-1965).
# 5초 안에 대표가 되지 않으면 그대로 started 를 내고, 그때는 stop 이 pid 에도 직접 신호를 보내 지킨다 — 시작 시각 키가 맞을 때만이다.
# 키를 못 남긴("<pid>-") 작업은 그룹 신호만 받으므로, setsid 전이면 TERM 대기 뒤 KILL(그룹)을 보낼 때 그룹이 서 있어야 끝난다.
# exit 가 없고 pid 의 프로세스도 없으면(세션 종료·재부팅으로 죽음) lost 다 — 부르는 쪽이 다시 띄운다.
here=$(cd "$(dirname "$0")" && pwd)
. "$here/gw-lib.sh"

usage() {
  echo "사용법: bg-job start <MAIN> <이슈 키> <작업 폴더> -- <명령…> | status <MAIN> <이슈 키> | clear|stop <MAIN> <이슈 키>" >&2
  exit 2
}

[ $# -ge 3 ] || usage
_bj_cmd=$1 _bj_main=$2 _bj_key=$3
shift 3
# 이슈 키는 파일 이름으로 쓰므로 경로 조작을 막는다.
gw_valid_name "$_bj_key" || usage
_bj_dir="$_bj_main/.work-loop/state/jobs"
_bj_base="$_bj_dir/$_bj_key"

# 상태 한 단어를 내고 _bj_state 에도 둔다 — stop 이 서브셸 없이 불러 읽은 pid(_bj_pid)를 그대로 쓰게(WP-1207).
bj_say() { _bj_state=$1; echo "$1"; }

# 그 프로세스 그룹에 프로세스가 남아 있으면 0. kill -0 은 권한 없음(EPERM)도 실패라 「끝남」으로 잘못 보므로 ps 로 본다.
bj_group_alive() {
  ps -axo pgid= 2>/dev/null | awk -v g="$1" '$1 == g { f = 1 } END { exit !f }'
}

# 그 pid 가 자기 프로세스 그룹의 대표(pgid == pid)면 0 — setsid 를 마쳤다는 뜻이다(WP-1965).
bj_is_leader() {
  [ "$(ps -o pgid= -p "$1" 2>/dev/null | tr -d ' ')" = "$1" ]
}

# pid 가 pid 파일에서 읽은 값(_bj_held)의 그 작업이면 0 — 시작 시각까지 같아야 한다(pid 재사용이면 남의 프로세스).
# 시작 시각을 못 남겼으면("<pid>-") 살아 있는지만 본다 — 생존 판정용이다(끝낸 것으로 잘못 보지 않게)(WP-1965).
bj_same_job() {
  [ "$_bj_held" = "$1-" ] || bj_same_job_strict "$1"
}

# 시작 시각 키까지 맞을 때만 0 — pid 직접 신호용이다. 키가 없으면("<pid>-") 재사용된 남의 pid 일 수 있어 건너뛴다(WP-1965 리뷰 후속).
bj_same_job_strict() {
  [ "$_bj_held" != "$1-" ] && [ "$(gw_proc_key "$1" 2>/dev/null)" = "$_bj_held" ]
}

# 그 pid 가 살아 있고 좀비(끝났지만 부모가 거두지 않음 — kill -0 은 성공한다)가 아니면 0 — ps 상태로 본다(WP-1965 리뷰 후속).
bj_pid_running() {
  gw_pid_alive "$1" || return 1
  case "$(ps -o stat= -p "$1" 2>/dev/null)" in *Z*) return 1 ;; esac
  return 0
}

# start 가 띄운 작업의 pid 파일을 시작 시각 키로 쓴다 — 아직 못 읽었으면 다시 읽어 본다. 못 읽으면 "<pid>-" 그대로 둔다.
# 대기 루프와 끊길 때(trap)가 함께 불러, start 가 중간에 끊겨도 키 없는 pid 파일이 남지 않게 한다(WP-1965 리뷰 후속).
# 자식이 이미 끝났으면(없음·좀비) 읽지 않는다 — 거둔 뒤 재사용된 남의 pid 키를 적게 된다.
# pid 파일이 남아 있을 때만 고쳐 쓴다 — 대기 중 stop 이 파일을 지웠으면 되살리지 않는다. 실패해도 작업은 이미 떴으니 start 를 실패로 만들지 않는다.
bj_write_key() {
  [ -n "$_bj_k" ] && return 0
  bj_pid_running "$_bj_pid" || return 0
  _bj_k=$(gw_proc_key "$_bj_pid" 2>/dev/null) || _bj_k=""
  [ -n "$_bj_k" ] || return 0
  [ -f "$_bj_base.pid" ] || return 0
  gw_write_atomic "$_bj_base.pid" "$_bj_k" || true
}

# 그 그룹에 프로세스가 남았거나 같은 작업의 pid 가 살아 있으면 0 — setsid 전이라 그룹이 아직 없는 작업도 살아 있다고 본다(WP-1965).
# pid 가 재사용됐으면(같은 작업이 아니면) 끝난 것으로 본다.
bj_job_alive() {
  bj_group_alive "$1" || { gw_pid_alive "$1" && bj_same_job "$1"; }
}

# 작업에 신호를 보낸다 — 그룹째(대표가 띄운 셸이라 E2E·gradle 자식까지), 그리고 아직 setsid 전이라 그룹이 없거나
# 막 대표가 된 틈일 수 있어 pid 에도 직접 보낸다(대표에게 두 번 가도 무해). pid 직접 신호는 시작 시각 키가 맞을 때만 — 키가 없으면 재사용된 남의 pid 인지
# 가를 수 없어 보내지 않는다(그룹 신호만)(WP-1965).
# `kill -TERM -- <음수>` 는 dash(우분투 /bin/sh)가 「Illegal number」로 거절해 아무것도 끝내지 못했다(WP-1207) —
# dash·bash·macOS sh 가 모두 받는 `kill -s <신호> -- <대상>` 꼴로 쓴다.
bj_signal() {
  kill -s "$1" -- "-$2" 2>/dev/null || true
  if gw_pid_alive "$2" && bj_same_job_strict "$2"; then
    kill -s "$1" -- "$2" 2>/dev/null || true
  fi
}

# 이 키의 작업 파일(log·exit·pid·dir)을 모두 지운다 — stop·clear 가 같이 쓴다.
bj_remove_files() {
  rm -f "$_bj_base.log" "$_bj_base.exit" "$_bj_base.pid" "$_bj_base.dir"
}

# 지금 상태 한 단어(failed 는 코드 포함)를 낸다.
bj_status() {
  if [ -f "$_bj_base.exit" ]; then
    _bj_code=""
    { IFS= read -r _bj_code || true; } < "$_bj_base.exit"
    if [ "$_bj_code" = 0 ]; then bj_say passed; else bj_say "failed ${_bj_code:-?}"; fi
    return
  fi
  [ -f "$_bj_base.pid" ] || { bj_say none; return; }
  _bj_held=""
  { IFS= read -r _bj_held || true; } < "$_bj_base.pid"
  _bj_pid=${_bj_held%%-*}
  case "$_bj_pid" in '' | *[!0-9]*) bj_say lost; return ;; esac
  # 살아 있고 시작 시각까지 같아야 내가 띄운 작업이다(pid 재사용이면 lost). 시작 시각을 못 남겼으면 살아 있는지만 본다.
  if gw_pid_alive "$_bj_pid" && { [ "$_bj_held" = "$_bj_pid-" ] || [ "$(gw_proc_key "$_bj_pid" 2>/dev/null)" = "$_bj_held" ]; }; then
    bj_say running
  elif [ -f "$_bj_base.exit" ]; then
    # 맨 위에서 exit 파일을 본 뒤 프로세스를 보기 전에 끝났다 — 끝나기 전에 exit 파일을 남기므로(mv 뒤 종료) 다시 보면 결과가 있다.
    bj_status
  else
    bj_say lost
  fi
}

case "$_bj_cmd" in
  status)
    [ $# -eq 0 ] || usage
    bj_status
    ;;
  stop)
    [ $# -eq 0 ] || usage
    # 서브셸 없이 불러 상태를 확인한 그 pid 로 끝낸다 — 다시 읽으면 그 사이 바뀐 파일(빈 값·다른 작업)을 끝낼 수 있다.
    bj_status >/dev/null
    if [ "$_bj_state" = running ]; then
      # 그룹 대표(띄운 셸)의 pid 가 곧 그룹 번호다. setsid 전(그룹 없음)이어도 시작 시각 키가 맞으면 pid 직접 신호가 그 프로세스를 끝낸다 — 아직 자식이 없다.
      bj_signal TERM "$_bj_pid"
      # gradle·Playwright 는 TERM 뒤 정리에 몇 초 걸린다 — 끝날 때까지 기다려야 「ok」 뒤 같은 키로 띄운 작업과 겹치지 않는다.
      _bj_i=0
      while bj_job_alive "$_bj_pid" && [ "$_bj_i" -lt 100 ]; do sleep 0.1; _bj_i=$((_bj_i + 1)); done
      if bj_job_alive "$_bj_pid"; then
        bj_signal KILL "$_bj_pid"
        _bj_i=0
        while bj_job_alive "$_bj_pid" && [ "$_bj_i" -lt 20 ]; do sleep 0.1; _bj_i=$((_bj_i + 1)); done
      fi
      if bj_job_alive "$_bj_pid"; then
        # 끝내지 못했으면 파일을 남기고 알린다 — 「ok」로 숨기면 몰래 돈 작업이 다음 작업의 결과를 덮는다.
        echo "bg-job: 작업(프로세스 그룹 $_bj_pid)을 끝내지 못했다" >&2
        exit 2
      fi
    fi
    bj_remove_files
    echo ok
    ;;
  clear)
    [ $# -eq 0 ] || usage
    [ "$(bj_status)" = running ] && { echo running; exit 1; }
    bj_remove_files
    echo ok
    ;;
  start)
    _bj_work=${1:-}
    [ -n "$_bj_work" ] && [ "${2:-}" = -- ] && [ $# -ge 3 ] || usage
    shift 2
    [ -d "$_bj_work" ] || { echo "작업 폴더가 없습니다: $_bj_work" >&2; exit 2; }
    [ "$(bj_status)" = running ] && { echo running; exit 1; }
    mkdir -p "$_bj_dir" || exit 2
    rm -f "$_bj_base.exit" "$_bj_base.pid"
    # 띄우기 전에 작업 폴더를 남긴다 — 도는 동안 늘 있어야 워크트리 정리가 그 폴더의 작업을 놓치지 않는다.
    _bj_real=$(gw_real_dir "$_bj_work") && gw_write_atomic "$_bj_base.dir" "$_bj_real" || exit 2
    # nohup + 표준 입력 끊기로 부른 세션(Bash 도구의 셸)이 끝나도 살아남게 한다.
    # 끝나면 종료 코드를 임시 파일에 쓰고 mv — status 가 빈 exit 파일을 읽지 않게.
    # 작업 폴더로 못 들어가도 종료 코드(2)를 남긴다 — lost 가 아니라 failed 로 보이게.
    set -- sh -c 'out=$2; if cd "$1"; then shift 2; "$@"; code=$?; else code=2; fi; echo "$code" > "$out.tmp" && mv -f "$out.tmp" "$out"' \
      bg-job "$_bj_work" "$_bj_base.exit" "$@"
    # 새 세션으로 — setsid(1) 이 없으면(macOS) perl 로 setsid(2) 뒤 exec 한다. 둘 다 exec 라 $! 가 곧 띄운 셸이다.
    if command -v setsid >/dev/null 2>&1; then
      set -- setsid "$@"
    else
      set -- perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV or exit 127' "$@"
    fi
    nohup "$@" > "$_bj_base.log" 2>&1 < /dev/null &
    _bj_pid=$!
    # 대기 동안에도 status 가 running 이도록(worktree-sweep 이 작업 없음으로 보지 않게) pid 파일을 먼저 남긴다 — 시작 시각을 바로 읽을 수 있으면
    # 처음부터 키로 쓰고(exec 해도 시작 시각은 그대로다), 못 읽었으면 "<pid>-" 로 두고 대기 중에 다시 읽어 고쳐 쓴다(WP-1965 리뷰 후속).
    _bj_k=""
    gw_write_atomic "$_bj_base.pid" "$_bj_pid-" || exit 2
    bj_write_key
    # 대기 중 start 가 끊겨도 키를 한 번 더 써 둔다 — 작업은 그대로 돌고, 키 없는 pid 파일로 남지 않게.
    trap 'bj_write_key; exit 130' INT
    trap 'bj_write_key; exit 143' TERM
    trap 'bj_write_key; exit 129' HUP
    # 자식이 setsid 를 마쳐 그룹 대표가 되거나 끝날 때까지 기다린다(최대 5초) — 그 전에 started 를 내면 곧바로 부른 stop 이 그룹을 못 찾는다(WP-1965).
    # setsid 전에 죽어 좀비가 된 자식(아직 거두지 않아 kill -0 은 성공)은 끝난 것으로 보고 기다리지 않는다.
    _bj_i=0
    while ! bj_is_leader "$_bj_pid" && bj_pid_running "$_bj_pid" && [ ! -f "$_bj_base.exit" ] && [ "$_bj_i" -lt 50 ]; do
      bj_write_key
      sleep 0.1
      _bj_i=$((_bj_i + 1))
    done
    # 아주 짧은 명령은 시작 시각을 읽기 전에 끝날 수 있다 — 그때는 exit 파일이 결과를 말하니 pid 만 남은 채 둔다.
    bj_write_key
    trap - INT TERM HUP
    echo "started $_bj_pid"
    ;;
  *)
    usage
    ;;
esac
