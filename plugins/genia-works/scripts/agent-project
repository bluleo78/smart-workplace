#!/bin/sh
# agent-project — AI 하나의 프로젝트 하나를 준비하고 칸으로 띄운다(WP-1053). start-agent(처음·다시 부르기)와
# work-loop(깨어날 때 새로 맡은 프로젝트를 찾으면 스스로)가 같은 절차를 쓰도록 한곳에 둔다. <AI 폴더> 는 <홈>/<AI 이름>(이름이 곧 AI 이름).
#
# agent-project repo <AI 폴더> <프로젝트 키> <저장소 주소> [<기본 브랜치>] — <AI 폴더>/repos/<키> 에 clone 하거나, 있으면 fetch 한다.
#   한 줄씩 낸다: cloned | fetched | fetch-failed(받기만 실패 — 띄우기는 한다),
#     branch-switched <브랜치>(바뀐 것 없는 clone 을 새 기본 브랜치로 옮김) | branch-kept <브랜치>(바뀐 것이 있거나 실패해 그대로 둠),
#     no-project-md(.work-loop/project.md 가 없다).
#   실패: clone-failed(종료 4 — 대개 git 자격 증명), url-changed(종료 5 — 폴더의 주소가 설정과 다르다, 건드리지 않음).
#   clone 은 임시 폴더에 받은 뒤 옮긴다 — 도중에 끊겨도 반쯤 받은 폴더가 제자리에 남아 「있는 clone」으로 쓰이지 않게.
#   키마다 잠근다 — 다른 쪽(돌고 있는 칸·start-agent)이 같은 키를 하고 있으면 busy(종료 6).
#   사람이 없는 칸에서도 부르므로 git 이 자격 증명·호스트 키를 묻지 않게 한다(묻는 대신 실패).
#
# agent-project start [--restart] <AI 폴더> <프로젝트 키> — 그 AI 신원으로 work-loop 를 도는 실행기를 칸으로 띄운다(agent-window 결과를 그대로 낸다).
#   실행기·대기열 라벨은 AI 폴더에 저장한 값(agent-home get cli·queue)을 쓴다 — 실행기별 명령·환경은 아래 cli_command 한곳에서 정한다(WP-1292).
#   칸에는 신원(GENIA_WORKS_AS), AI 폴더(GENIA_WORKS_AGENT_DIR — 새 프로젝트 확인)를 넘긴다. 이 셸의 PATH·GENIA_WORKS_API_URL·GENIA_WORKS_TENANT 는
#   agent-window 가 넘긴다(gw-lib 의 GW_TMUX_ENV — tmux 칸은 이 셸의 환경을 물려받지 않는다). 띄웠으면(started·exists·revived·restarted) 그 키의
#   실패 기록을 지우고, 그 AI 의 알림 감시 창(agent-events ensure — AI 당 하나)도 없거나 죽었으면 띄운다(결과 줄은 내지 않는다).
#   모델 로그인(WP-1334): 이 셸에 CLAUDE_CODE_OAUTH_TOKEN 이 있으면(Pod) 그 AI 의 토큰 파일(GW_HOME/agents/<이름>/claude-token, 권한 600)에 적고,
#   없으면 그대로 둔다(사람의 컴퓨터에서는 start-agent 패널이 gw-claude-token 으로 넣고 지운다) — 칸은 gw-claude-run 이 그 파일을 읽어
#   claude 를 띄운다(있으면 그 setup-token, 없으면 이 컴퓨터의 claude 로그인).
#
# agent-project login <AI 폴더> — 그 AI 의 칸이 다음에 뜰 때 쓸 모델 로그인을 낸다: setup-token(토큰 파일이 있다) | local.
#   토큰은 칸 명령 인자로 넘기지 않고, tmux 서버 환경으로도 새지 않는다(agent-window·agent-events 가 tmux 를 부르기 전에 지운다).
#   GW_SKIP_EVENTS_ENSURE=1 이면 감시 창은 챙기지 않는다 — 칸 여럿을 차례로 띄우는 엔트리포인트 감독이 회차 끝에 한 번만 챙긴다(WP-1252).
#
# agent-project add <AI 폴더> <프로젝트 키> <저장소 주소> [<기본 브랜치>] — work-loop 가 새로 맡은 프로젝트에 쓴다: repo 뒤 start.
#   repo 처럼 키마다 잠그고(busy, 종료 6), 사람이 손봐야 하는 실패(clone-failed·url-changed·legacy·no-tmux)는 이유를 기록하고
#   (start-agent 가 사람에게 보인다) 1시간 동안은 다시 하지 않는다(backoff, 종료 7) — 실패는 종료 1. 잠깐의 엇갈림은 busy(종료 6)로 기록하지 않는다.
#
# agent-project failures <AI 폴더> — 기록된 실패를 「<키> <이유>」 한 줄씩 낸다.
#
# agent-project locate <AI 이름> <지금 폴더> [--set] — 그 AI 의 홈을 정한다. start-agent 는 부른 폴더를 홈으로 쓰는데, 다른 폴더에서 부르면
#   (예: --restart 를 다른 곳에서) 홈이 바뀌어 clone·칸을 새로 만들게 된다 — 그래서 AI 마다 홈을 기억하고 그것을 쓴다.
#   홈은 기억한 홈(그 아래 <AI 이름> 폴더가 아직 있을 때) → 그 AI 의 tmux 칸이 도는 폴더(<홈>/<AI 이름>/repos/… — 0.1.22 이하로 띄움)
#   → 지금 폴더 아래 <AI 이름> 폴더가 있으면 지금 폴더 순으로 찾아 기억하고 한 줄 낸다:
#     here <지금 폴더> · elsewhere <홈>(다른 폴더 — 그것을 홈으로 쓴다)
#     new <지금 폴더> — 어디에도 없어 처음 정하는 홈이다. 기억하지 않는다 — 사람이 확인하면 --set 으로 기억한다.
#     ambiguous 뒤 한 줄씩 후보 홈(종료 3) — 칸이 여러 홈에서 돈다. 기억하지 않는다 — 사람이 고른 홈에서 --set 으로 기억한다.
#   --set: 지금 폴더를 홈으로 기억하고 「here <지금 폴더>」. 기억은 사용자 데이터 폴더(GW_HOME 아래 agents/<AI 이름>/home)에 둔다.
here=$(cd "$(dirname "$0")" && pwd)
. "$here/gw-lib.sh"

# 이 AI 의 setup-token 파일·사용자 데이터 폴더(gw-lib 공용 — gw-claude-token 과 같은 곳).
token_file() {
  gw_claude_token_file "$name"
}
agent_data_dir() {
  gw_agent_data_dir "$name"
}

usage() {
  echo "사용: agent-project repo|add <AI 폴더> <프로젝트 키> <저장소 주소> [<기본 브랜치>] · start [--restart] <AI 폴더> <프로젝트 키> · failures|login <AI 폴더> · locate|cli <AI 이름> <지금 폴더>" >&2
  exit 2
}

cmd=${1:-}
[ -n "$cmd" ] && shift

if [ "$cmd" = cli ]; then
  # 그 AI 칸이 쓸 실행기를 읽기만 한다(start-agent 패널이 로그인을 물을지 정할 때, WP-1337) — locate 와 달리 홈을 기억하지 않는다.
  # 홈은 기억한 값, 없으면 지금 폴더에 그 AI 폴더가 있을 때의 지금 폴더. 모르거나 저장값이 목록 밖이면 claude(묻는 쪽이 안전하다).
  name=${1:-}
  cur=${2:-}
  gw_valid_name "$name" || usage
  saved=$(head -n 1 "$GW_HOME/agents/$name/home" 2>/dev/null)
  if [ -n "$saved" ] && [ -d "$saved/$name" ]; then aidir=$saved/$name
  elif [ -n "$cur" ] && [ -d "$cur/$name" ]; then aidir=$cur/$name
  else echo claude; exit 0
  fi
  v=$("$here/agent-home" "$aidir" get cli 2>/dev/null)
  if gw_valid_cli "$v"; then echo "$v"; else echo claude; fi
  exit 0
fi

if [ "$cmd" = locate ]; then
  name=${1:-}
  cur=${2:-}
  gw_valid_name "$name" && [ -d "$cur" ] || usage
  # 실제 경로로 맞춘다 — tmux 가 알려 주는 칸 폴더는 심볼릭 링크를 푼 경로라(macOS 의 /var → /private/var 등) 그대로 비교하면 다르게 보인다.
  cur=$(gw_real_dir "$cur") || usage
  record="$GW_HOME/agents/$name/home"
  saved=$(head -n 1 "$record" 2>/dev/null)
  save() {
    [ "$1" = "$saved" ] && return 0
    agent_data_dir && gw_write_atomic "$record" "$1" || { echo "agent-project: 홈을 기억하지 못했습니다($record)" >&2; exit 1; }
  }
  if [ "${3:-}" = --set ]; then
    save "$cur"
    echo "here $cur"
    exit 0
  fi
  home=""
  if [ -n "$saved" ] && [ -d "$saved/$name" ]; then
    # 기억한 값은 늘 실제 경로로 적었다(save 를 부르는 쪽이 gw_real_dir 로 푼 값).
    home=$saved
  else
    # 기억이 없으면 돌고 있는 칸의 폴더에서 찾는다 — work-loop 가 워크트리로 들어가 있어도 경로에 /<AI 이름>/repos/ 가 남는다.
    # 패턴 안의 "$name" 은 글자 그대로 맞춘다(이름의 . 이 아무 글자와 맞지 않게).
    found=$("$here/agent-window" --paths "$name" 2>/dev/null | while IFS= read -r p; do
      case $p in (*/"$name"/repos/*) h=${p%/"$name"/repos/*}; [ -d "$h/$name" ] && gw_real_dir "$h" ;; esac
    done | sort -u)
    case "$found" in
      '') ;;
      *'
'*)
        # 칸이 여러 홈에서 돈다(홈이 바뀌던 결함으로 생길 수 있다) — 하나를 짐작해 기억하지 않고 사람에게 고르게 한다.
        echo ambiguous
        printf '%s\n' "$found"
        exit 3
        ;;
      *) home=$found ;;
    esac
  fi
  if [ -z "$home" ]; then
    if [ -d "$cur/$name" ]; then
      home=$cur
    else
      # 기억도 돌고 있는 칸도 없다 — 처음 정하는 홈이라 기억하지 않고 확인을 받게 한다(재부팅 뒤 엉뚱한 폴더에서 부른 경우를 걸러 낸다).
      echo "new $cur"
      exit 0
    fi
  fi
  save "$home"
  if [ "$home" = "$cur" ]; then echo "here $cur"; else echo "elsewhere $home"; fi
  exit 0
fi

restart=""
if [ "$cmd" = start ] && [ "${1:-}" = --restart ]; then
  restart=--restart
  shift
fi
# AI 폴더 이름이 AI 이름(GENIA_WORKS_AS)·tmux 세션 이름이 된다.
aidir=$(gw_ai_dir "${1:-}") || { echo "AI 폴더가 아닙니다: ${1:-}" >&2; exit 2; }
name=$(basename "$aidir")
state="$aidir/state"

if [ "$cmd" = login ]; then
  # 칸이 다음에 뜰 때 쓸 모델 로그인 — 원문은 내지 않는다.
  if [ -s "$(token_file)" ]; then echo setup-token; else echo local; fi
  exit 0
fi

if [ "$cmd" = failures ]; then
  for f in "$state"/launch-failed-*; do
    [ -f "$f" ] && printf '%s %s\n' "${f##*/launch-failed-}" "$(head -n 1 "$f")"
  done
  exit 0
fi

key=${2:-}
gw_valid_project_key "$key" || usage
folder="$aidir/repos/$key"

export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes}"

do_repo() {
  url=$1
  branch=$2
  [ -n "$url" ] || usage
  if [ ! -d "$folder" ]; then
    mkdir -p "$aidir/repos"
    # 끊긴 앞선 clone 이 남긴 임시 폴더를 치운다(키 잠금을 잡고 있어 지금 받는 쪽은 없다).
    rm -rf "$aidir/repos/.$key.clone."*
    tmp=$(mktemp -d "$aidir/repos/.$key.clone.XXXXXX") || { echo clone-failed; return 4; }
    if ! git clone -q ${branch:+--branch "$branch"} -- "$url" "$tmp" >&2; then
      rm -rf "$tmp"
      echo clone-failed
      return 4
    fi
    mv "$tmp" "$folder" || { rm -rf "$tmp"; echo clone-failed; return 4; }
    echo cloned
  else
    # 처음 넣은 주소로 비교한다 — remote get-url 은 insteadOf 로 바꾼 주소를 돌려줘 달라 보일 수 있다.
    if [ "$(git -C "$folder" config --get remote.origin.url)" != "$url" ]; then
      echo url-changed
      return 5
    fi
    if git -C "$folder" fetch -q --prune origin >&2; then echo fetched; else echo fetch-failed; fi
    # 작업 브랜치·워크트리는 그 프로젝트의 work-loop 가 다룬다 — 바뀐 것 없는 clone 만 새 기본 브랜치로 옮긴다.
    if [ -n "$branch" ] && [ "$(git -C "$folder" branch --show-current)" != "$branch" ]; then
      if [ -z "$(git -C "$folder" status --porcelain)" ] && git -C "$folder" checkout -q "$branch" >&2; then
        echo "branch-switched $branch"
      else
        echo "branch-kept $branch"
      fi
    fi
  fi
  [ -f "$folder/.work-loop/project.md" ] || echo no-project-md
  return 0
}

# 키 잠금 — 같은 키를 칸 여럿이·start-agent 와 동시에 준비하거나 띄우지 않게. 잡혀 있으면 busy 로 끝낸다(종료 6).
lock_key() {
  mkdir -p "$state"
  gw_dir_lock "$state/launch-$key.lock" || { echo busy; exit 6; }
}

# 칸이 떠 있는 결과인지(agent-window 의 started·exists·revived·restarted).
launched() {
  case "$1" in started* | exists* | revived* | restarted*) return 0 ;; esac
  return 1
}

do_start() {
  [ -d "$folder" ] || { echo "저장소 폴더가 없습니다 — 먼저 agent-project repo: $folder" >&2; return 2; }
  cli=$("$here/agent-home" "$aidir" get cli 2>/dev/null) || cli=claude
  gw_valid_cli "$cli" || { echo "모르는 실행기: $cli — agent-home set cli 로 고치세요" >&2; return 2; }
  queue=$("$here/agent-home" "$aidir" get queue 2>/dev/null) || queue=""
  args=$(gw_loop_args "$key" "$queue")
  # PATH·서버 주소·워크스페이스는 agent-window 가 칸마다 넘긴다(GW_TMUX_ENV).
  set -- env "GENIA_WORKS_AS=$name" "GENIA_WORKS_AGENT_DIR=$aidir"
  # 실행기별 칸 명령·환경은 여기 한곳에서 정한다(WP-1292). work-loop 인자는 $args(프로젝트 키와 --queue).
  #   claude — /loop 가 반복·다음 확인을 맡고, 알림 깨우기는 감시 창(agent-events poke)이 쉬는 칸에 /loop 를 넣어 한다(WP-1403 —
  #            칸의 모델이 Monitor 걸기를 건너뛰면 깨어나지 못했다). GENIA_WORKS_WAKE_MODE=pane 으로 work-loop 에 「Monitor 를 걸지 않는다」를 알린다(WP-1427 —
  #            work-loop 은 gw-wake-mode 한 곳에서만 판단한다. 하위 호환으로 GENIA_WORKS_PANE_WAKES=1 도 함께 넘긴다).
  #            자동 압축 40%(work-loop.sh 와 같은 값 — 오래 도는 세션이 무거워지지 않게).
  #   genia  — genia-works 확장의 /gw-loop 가 반복·알림 깨우기를 맡는다(WP-1294). genia 인증서를 고정한다 — 이 셸의 NODE_EXTRA_CA_CERTS 가
  #            다른 값이면 genia 실행 스크립트가 자기 인증서를 쓰지 않아 「Connection error」가 난다.
  #   codex  — 바깥 구동기 gw-codex-loop 가 반복·알림 깨우기를 맡는다(WP-1295).
  #   genia·codex 는 GENIA_WORKS_WAKE_MODE=runner(와 하위 호환 GENIA_WORKS_RUNNER_WAKES=1)로 work-loop 에 「깨우기·다음 확인은 실행기가 한다」를 알린다(WP-1293·1427).
  case "$cli" in
    claude)
      # 이 셸에 CLAUDE_CODE_OAUTH_TOKEN 이 있으면(Pod — Secret 에서 받는다, 또는 사람이 일반 셸에서 부름) AI 별 파일에 적는다
      # (같은 AI 의 칸이 동시에 읽어도 반쯤 쓴 토큰을 보지 않게 원자적으로). 없으면 파일을 그대로 둔다 — 사람의 홈 claude 안에서는
      # claude 가 이 변수를 넘기지 않아 늘 비어 있고, 토큰은 start-agent 패널이 gw-claude-token 으로 넣고 지운다.
      tokfile=$(token_file)
      if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
        agent_data_dir && gw_write_atomic "$tokfile" "$CLAUDE_CODE_OAUTH_TOKEN" ||
          { echo "setup-token 을 적지 못했습니다: $tokfile" >&2; return 2; }
      fi
      # GENIA_WORKS_UNATTENDED=1 — 사람이 지켜보지 않는 칸이라는 표시. 플러그인이 확인 창(ask)을 창 대신 거절로 바꾼다(WP-1398).
      set -- "$@" GENIA_WORKS_UNATTENDED=1 GENIA_WORKS_WAKE_MODE=pane GENIA_WORKS_PANE_WAKES=1 CLAUDE_AUTOCOMPACT_PCT_OVERRIDE=40 "$here/gw-claude-run" "$tokfile" \
        claude --permission-mode bypassPermissions "/loop /genia-works:work-loop $args"
      ;;
    genia)
      crt="${GENIA_CA_CERT:-$HOME/.genia/app/genia-root.crt}"
      set -- "$@" GENIA_WORKS_WAKE_MODE=runner GENIA_WORKS_RUNNER_WAKES=1
      [ -f "$crt" ] && set -- "$@" "NODE_EXTRA_CA_CERTS=$crt"
      # genia-works 확장·스킬은 이 플러그인 폴더(package.json 의 pi 목록)를 -e 로 싣는다 — 설치 없이 지금 플러그인 버전을 쓴다.
      set -- "$@" genia --approve -e "$(cd "$here/.." && pwd)" "/gw-loop $args"
      ;;
    codex)
      set -- "$@" GENIA_WORKS_WAKE_MODE=runner GENIA_WORKS_RUNNER_WAKES=1 "$here/gw-codex-loop" "$args"
      ;;
  esac
  # shellcheck disable=SC2086 # restart 는 비었거나 --restart 한 단어다.
  result=$("$here/agent-window" $restart "$name" "$key" "$folder" "$@")
  rc=$?
  printf '%s\n' "$result"
  launched "$result" && rm -f "$state/launch-failed-$key"
  # 그 AI 의 알림 감시 창도 띄워 둔다(WP-1252 — AI 당 하나, 칸은 그 기록만 따라간다). 결과 줄·종료 코드는 칸 결과(위)를 가리지 않게 버린다.
  # 사람이 부르는 start-agent·work-loop 의 add 는 늘 챙기고, 회차 끝에 따로 챙기는 엔트리포인트 감독만 끈다(GW_SKIP_EVENTS_ENSURE).
  [ -z "${GW_SKIP_EVENTS_ENSURE:-}" ] && launched "$result" && "$here/agent-events" ensure "$aidir" >/dev/null 2>&1
  return $rc
}

case "$cmd" in
  repo)
    lock_key
    do_repo "${3:-}" "${4:-}"
    ;;
  start)
    do_start
    ;;
  add)
    failed="$state/launch-failed-$key"
    if [ -n "$(find "$failed" -mmin -60 2>/dev/null)" ]; then
      echo backoff
      exit 7
    fi
    lock_key
    out=$(do_repo "${3:-}" "${4:-}") && out="$out
$(do_start)"
    printf '%s\n' "$out"
    last=$(printf '%s\n' "$out" | tail -n 1)
    launched "$last" && exit 0
    case "$last" in
      # 사람이 손봐야 하는 실패만 이유를 남기고 1시간 쉰다 — start-agent 가 사람에게 보인다.
      clone-failed | url-changed | legacy* | no-tmux)
        printf '%s\n' "$last" > "$failed"
        exit 1
        ;;
    esac
    # 그 밖(세션 잠금을 오래 못 잡음 등)은 잠깐의 엇갈림이라 기록하지 않고 다음 확인에서 다시 한다.
    echo busy
    exit 6
    ;;
  *)
    usage
    ;;
esac
