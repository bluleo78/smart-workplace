#!/bin/sh
# agent-project — AI 하나의 프로젝트 하나를 준비하고 칸으로 띄운다(WP-1053). start-agent(처음·다시 부르기)와
# work-loop(깨어날 때 새로 맡은 프로젝트를 찾으면 스스로)가 같은 절차를 쓰도록 한곳에 둔다. <AI 폴더> 는 <홈>/<AI 이름>(이름이 곧 AI 이름).
#
# agent-project repo <AI 폴더> <프로젝트 키> <저장소 주소> [<기본 브랜치>] — <AI 폴더>/repos/<키> 에 clone 하거나, 있으면 fetch 한다.
#   한 줄씩 낸다: cloned | fetched | fetch-failed(받기만 실패 — 띄우기는 한다),
#     branch-switched <브랜치>(바뀐 것 없는 clone 을 새 기본 브랜치로 옮김) | branch-kept <브랜치>(바뀐 것이 있거나 실패해 그대로 둠),
#     no-project-md(.work-loop/project.md 가 없다).
#   실패: clone-failed(종료 4 — 대개 git 자격 증명), url-changed(종료 5 — 폴더의 주소가 설정과 다르다, 건드리지 않음).
#   clone 은 임시 폴더에 받은 뒤 옮긴다 — 도중에 끊겨도 반쯤 받은 폴더가 제자리에 남아 「있는 clone」으로 쓰이지 않게.
#   키마다 잠근다 — 다른 쪽(돌고 있는 칸·start-agent)이 같은 키를 하고 있으면 busy(종료 6).
#   사람이 없는 칸에서도 부르므로 git 이 자격 증명·호스트 키를 묻지 않게 한다(묻는 대신 실패).
#
# agent-project start [--restart] <AI 폴더> <프로젝트 키> — 그 AI 신원으로 work-loop 를 도는 claude 를 칸으로 띄운다(agent-window 결과를 그대로 낸다).
#   대기열 라벨은 AI 폴더에 저장한 값(agent-home get queue)을 쓴다. 칸에는 신원(GENIA_WORKS_AS), AI 폴더(GENIA_WORKS_AGENT_DIR — 새 프로젝트 확인),
#   자동 압축 40%(work-loop.sh 와 같은 값 — 오래 도는 세션이 무거워지지 않게)를 넘기고, 이 셸에 GENIA_WORKS_API_URL 이 있으면 그것도 넘긴다
#   (운영이 아닌 서버 — tmux 칸은 이 셸의 환경을 물려받지 않는다). 띄웠으면(started·exists·revived·restarted) 그 키의 실패 기록을 지운다.
#
# agent-project add <AI 폴더> <프로젝트 키> <저장소 주소> [<기본 브랜치>] — work-loop 가 새로 맡은 프로젝트에 쓴다: repo 뒤 start.
#   repo 처럼 키마다 잠그고(busy, 종료 6), 사람이 손봐야 하는 실패(clone-failed·url-changed·legacy·no-tmux)는 이유를 기록하고
#   (start-agent 가 사람에게 보인다) 1시간 동안은 다시 하지 않는다(backoff, 종료 7) — 실패는 종료 1. 잠깐의 엇갈림은 busy(종료 6)로 기록하지 않는다.
#
# agent-project failures <AI 폴더> — 기록된 실패를 「<키> <이유>」 한 줄씩 낸다.
here=$(cd "$(dirname "$0")" && pwd)
. "$here/gw-lib.sh"

usage() {
  echo "사용: agent-project repo|add <AI 폴더> <프로젝트 키> <저장소 주소> [<기본 브랜치>] · start [--restart] <AI 폴더> <프로젝트 키> · failures <AI 폴더>" >&2
  exit 2
}

cmd=${1:-}
[ -n "$cmd" ] && shift
restart=""
if [ "$cmd" = start ] && [ "${1:-}" = --restart ]; then
  restart=--restart
  shift
fi
# AI 폴더 이름이 AI 이름(GENIA_WORKS_AS)·tmux 세션 이름이 된다.
aidir=$(gw_ai_dir "${1:-}") || { echo "AI 폴더가 아닙니다: ${1:-}" >&2; exit 2; }
name=$(basename "$aidir")
state="$aidir/state"

if [ "$cmd" = failures ]; then
  for f in "$state"/launch-failed-*; do
    [ -f "$f" ] && printf '%s %s\n' "${f##*/launch-failed-}" "$(head -n 1 "$f")"
  done
  exit 0
fi

key=${2:-}
gw_valid_project_key "$key" || usage
folder="$aidir/repos/$key"

export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes}"

do_repo() {
  url=$1
  branch=$2
  [ -n "$url" ] || usage
  if [ ! -d "$folder" ]; then
    mkdir -p "$aidir/repos"
    # 끊긴 앞선 clone 이 남긴 임시 폴더를 치운다(키 잠금을 잡고 있어 지금 받는 쪽은 없다).
    rm -rf "$aidir/repos/.$key.clone."*
    tmp=$(mktemp -d "$aidir/repos/.$key.clone.XXXXXX") || { echo clone-failed; return 4; }
    if ! git clone -q ${branch:+--branch "$branch"} -- "$url" "$tmp" >&2; then
      rm -rf "$tmp"
      echo clone-failed
      return 4
    fi
    mv "$tmp" "$folder" || { rm -rf "$tmp"; echo clone-failed; return 4; }
    echo cloned
  else
    # 처음 넣은 주소로 비교한다 — remote get-url 은 insteadOf 로 바꾼 주소를 돌려줘 달라 보일 수 있다.
    if [ "$(git -C "$folder" config --get remote.origin.url)" != "$url" ]; then
      echo url-changed
      return 5
    fi
    if git -C "$folder" fetch -q --prune origin >&2; then echo fetched; else echo fetch-failed; fi
    # 작업 브랜치·워크트리는 그 프로젝트의 work-loop 가 다룬다 — 바뀐 것 없는 clone 만 새 기본 브랜치로 옮긴다.
    if [ -n "$branch" ] && [ "$(git -C "$folder" branch --show-current)" != "$branch" ]; then
      if [ -z "$(git -C "$folder" status --porcelain)" ] && git -C "$folder" checkout -q "$branch" >&2; then
        echo "branch-switched $branch"
      else
        echo "branch-kept $branch"
      fi
    fi
  fi
  [ -f "$folder/.work-loop/project.md" ] || echo no-project-md
  return 0
}

# 키 잠금 — 같은 키를 칸 여럿이·start-agent 와 동시에 준비하거나 띄우지 않게. 잡혀 있으면 busy 로 끝낸다(종료 6).
lock_key() {
  mkdir -p "$state"
  gw_dir_lock "$state/launch-$key.lock" || { echo busy; exit 6; }
}

# 칸이 떠 있는 결과인지(agent-window 의 started·exists·revived·restarted).
launched() {
  case "$1" in started* | exists* | revived* | restarted*) return 0 ;; esac
  return 1
}

do_start() {
  [ -d "$folder" ] || { echo "저장소 폴더가 없습니다 — 먼저 agent-project repo: $folder" >&2; return 2; }
  queue=$("$here/agent-home" "$aidir" get queue 2>/dev/null) || queue=""
  loop="/loop /genia-works:work-loop $key"
  [ -n "$queue" ] && loop="$loop --queue \"$queue\""
  set -- env "GENIA_WORKS_AS=$name" "GENIA_WORKS_AGENT_DIR=$aidir" "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE=40"
  [ -n "${GENIA_WORKS_API_URL:-}" ] && set -- "$@" "GENIA_WORKS_API_URL=$GENIA_WORKS_API_URL"
  # shellcheck disable=SC2086 # restart 는 비었거나 --restart 한 단어다.
  result=$("$here/agent-window" $restart "$name" "$key" "$folder" "$@" claude --permission-mode bypassPermissions "$loop")
  rc=$?
  printf '%s\n' "$result"
  launched "$result" && rm -f "$state/launch-failed-$key"
  return $rc
}

case "$cmd" in
  repo)
    lock_key
    do_repo "${3:-}" "${4:-}"
    ;;
  start)
    do_start
    ;;
  add)
    failed="$state/launch-failed-$key"
    if [ -n "$(find "$failed" -mmin -60 2>/dev/null)" ]; then
      echo backoff
      exit 7
    fi
    lock_key
    out=$(do_repo "${3:-}" "${4:-}") && out="$out
$(do_start)"
    printf '%s\n' "$out"
    last=$(printf '%s\n' "$out" | tail -n 1)
    launched "$last" && exit 0
    case "$last" in
      # 사람이 손봐야 하는 실패만 이유를 남기고 1시간 쉰다 — start-agent 가 사람에게 보인다.
      clone-failed | url-changed | legacy* | no-tmux)
        printf '%s\n' "$last" > "$failed"
        exit 1
        ;;
    esac
    # 그 밖(세션 잠금을 오래 못 잡음 등)은 잠깐의 엇갈림이라 기록하지 않고 다음 확인에서 다시 한다.
    echo busy
    exit 6
    ;;
  *)
    usage
    ;;
esac
