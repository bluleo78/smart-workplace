#!/bin/sh
# work-loop 의 main 머지 전 확인 — MAIN(사람과 같이 쓰는 main 작업 폴더)에 브랜치를 머지해도 되는지(WP-376).
#
#   merge-ready <MAIN> <브랜치>
#
# 머지해도 되면 아무것도 출력하지 않고 0, 아니면 막는 까닭을 한 줄에 하나씩 출력하고 1(사용법 오류는 2).
# 사람이 하던 일(머지·rebase·스테이징·고치던 파일)을 건드릴 수 있으면 막는다 — work-loop 는 「main 머지 대기」로 두고 다음에 다시 본다.
#   1. 브랜치가 work-loop 의 것(ai/*)이다 — 사람의 브랜치는 머지하지 않는다.
#   2. MAIN 의 현재 브랜치가 main 이다.
#   3. MAIN 에 진행 중인 git 작업(머지·rebase·cherry-pick·revert)이 없다(rebase 는 rebase-merge·rebase-apply 폴더로 본다).
#   4. 스테이징한 변경이 없다.
#   5. MAIN 에서 바뀐 파일(추적 중인 변경 + 추적 안 된 새 파일)과 브랜치가 바꾼 파일이 겹치지 않는다.
#      이름 바꾸기는 --no-renames 로 옛 이름·새 이름을 모두 센다.
[ $# -eq 2 ] && [ -n "$1" ] && [ -n "$2" ] || { echo "사용법: merge-ready <MAIN> <브랜치>" >&2; exit 2; }
main=$1
branch=$2
blocked=0

# 막는 까닭 한 줄
block() {
  echo "$*"
  blocked=1
}

case "$branch" in
  ai/*) ;;
  *) block "ai/* 브랜치가 아니다: $branch" ;;
esac

cur=$(git -C "$main" symbolic-ref --short -q HEAD)
[ "$cur" = main ] || block "main 작업 폴더가 main 이 아니다: ${cur:-분리된 HEAD}"

# rebase 는 rebase-merge·rebase-apply 폴더로 본다. REBASE_HEAD 는 끝난 rebase(pull --rebase 등)가 남겨 두기도 해서,
# 그걸 보면 사람이 아무것도 안 하는데도 그 저장소에선 늘 막혀 「main 머지 대기」에서 못 벗어난다.
for n in MERGE_HEAD rebase-merge rebase-apply CHERRY_PICK_HEAD REVERT_HEAD; do
  [ -e "$(git -C "$main" rev-parse --path-format=absolute --git-path "$n")" ] && block "진행 중: $n"
done

git -C "$main" diff --cached --quiet || block "스테이징한 변경이 있다"

if git -C "$main" rev-parse -q --verify "refs/heads/$branch" >/dev/null; then
  t=$(mktemp -d)
  { git -C "$main" diff --name-only --no-renames -z HEAD; git -C "$main" ls-files --others --exclude-standard -z; } \
    | tr '\0' '\n' | sort -u > "$t/main"
  # 차이를 읽지 못하면(빈 결과로 「겹치지 않음」이 되지 않게) 막는다.
  if git -C "$main" diff --name-only --no-renames -z "main...$branch" > "$t/raw"; then
    tr '\0' '\n' < "$t/raw" | sort -u > "$t/branch"
    overlap=$(comm -12 "$t/main" "$t/branch")
    [ -z "$overlap" ] || { printf '%s\n' "$overlap" | sed 's/^/겹치는 파일: /'; blocked=1; }
  else
    block "main...$branch 의 차이를 읽지 못했다"
  fi
  rm -rf "$t"
else
  block "브랜치가 없다: $branch"
fi

exit "$blocked"
