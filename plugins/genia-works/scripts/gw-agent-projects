#!/bin/sh
# gw-agent-projects <AI 이름> [페이지] — 등록한 AI 키로 그 AI 에게 보이는 프로젝트 목록 한 페이지(GET /projects, 100개씩)를 JSON 그대로 낸다(WP-1046).
# 응답은 { content, page, size, totalElements, totalPages } — 다음 페이지는 page+1 < totalPages 일 때 부른다.
#
# gw-agent-projects --assigned <AI 이름> — 「이 AI 가 맡을 프로젝트」를 「키<탭>저장소 주소<탭>브랜치」(브랜치는 없으면 빈 칸) 한 줄씩 낸다.
# 프로젝트가 없어도 0(빈 출력). 고르는 기준은 서버 한 곳(GET /agent-runtime/me/projects, WP-1275)에 있다 — 관리자 화면의 「맡는 프로젝트」와 같다:
#   · 실제 멤버(직접 또는 멤버로 둔 부서 — 관리자라 보이기만 하는 프로젝트는 아니다) · 연결된 저장소가 있다
#   · 키가 폴더·tmux 칸 이름이 되므로 ^[A-Za-z0-9_-]+$ 형식이다(여기서도 gw_valid_project_key 로 한 번 더 거른다)
# start-agent 스킬과 작업 공간 이미지(엔트리포인트·알림 감시)가 이 기준을 따로 갖지 않고 이것을 부른다.
# 실패는 「gw-agent-projects: …」 한 줄을 표준 오류로 내고 끝낸다:
#   1 키 없음·키 파일 깨짐 · 4 키 거절(401) · 5 서버 오류·닿지 못함·응답이 JSON 이 아님(--assigned 에서 404 = 이 기능이 없는 옛 서버)
#   6 권한 없음(403 — 키는 맞다. --assigned 면 AI 키가 아닌 것)·워크스페이스를 밝히지 않음(--assigned 의 400) · 7 jq 없음(--assigned 가 JSON 을 거르는 데 쓴다)
# 키는 명령줄 인자로 넘기지 않고(ps 에 보인다) 표준 입력으로 curl 설정에 넣으며, 어디에도 출력하지 않는다.
# 서버 주소: GENIA_WORKS_API_URL(예: http://localhost:6160/api/v1), 없으면 운영 주소(gw_api_url).
here=$(cd "$(dirname "$0")" && pwd)
. "$here/gw-lib.sh"

assigned=""
if [ "${1:-}" = "--assigned" ]; then
  assigned=1
  shift
fi
name=${1:-}
page=${2:-0}
if [ -z "$name" ] || { [ -n "$assigned" ] && [ $# -gt 1 ]; }; then
  echo "사용: gw-agent-projects <AI 이름> [페이지] | gw-agent-projects --assigned <AI 이름>" >&2
  exit 2
fi
[ -z "$assigned" ] || page=0
case "$page" in
  '' | *[!0-9]*)
    echo "gw-agent-projects: 페이지는 0 이상 정수여야 합니다: $page" >&2
    exit 2
    ;;
esac
api=$(gw_api_url)

# 목록(gw-keys list)에는 파일만 있으면 보이므로, 파일은 있는데 키 형식이 아니면(2) 「없음」과 나눠 알린다.
key=$(gw_read_key "$name")
case $? in
  0) ;;
  2)
    echo "gw-agent-projects: $name 키 파일이 키 형식이 아닙니다 — /genia-works:login 에서 그 AI 의 키를 바꾸세요" >&2
    exit 1
    ;;
  *)
    echo "gw-agent-projects: $name 키가 이 컴퓨터에 없습니다 — /genia-works:login 으로 넣으세요" >&2
    exit 1
    ;;
esac

# 주소 하나를 읽어 본문을 GW_BODY 에 둔다. 닿지 못하면 상태 코드 000(또는 빈 값). 실패는 여기서 알리고 끝낸다(종료 코드는 위).
fetch() {
  gw_api_request "$key" 10 30 "$1"
  code=$GW_CODE
  case $code in
    200) return 0 ;;
    400)
      # 맡는 프로젝트 조회만 400 을 낸다 — 여러 워크스페이스에 속한 AI 가 어느 워크스페이스인지 밝히지 않았다(WP-1275).
      echo "gw-agent-projects: $name 은 여러 워크스페이스에 속해 있어 워크스페이스를 밝혀야 합니다(HTTP 400) — GENIA_WORKS_TENANT 를 넣으세요" >&2
      exit 6
      ;;
    401)
      echo "gw-agent-projects: $name 키가 거절됐습니다(HTTP 401) — 관리자 › 에이전트에서 다시 발급해 /genia-works:login 으로 바꾸세요" >&2
      exit 4
      ;;
    403)
      if [ -n "$assigned" ]; then
        echo "gw-agent-projects: $name 키로 맡을 프로젝트를 읽을 수 없습니다(HTTP 403) — AI 의 키인지 확인하세요" >&2
      else
        echo "gw-agent-projects: $name 에게 프로젝트를 볼 권한이 없습니다(HTTP 403) — 관리자에게 그 AI 의 역할을 확인하세요" >&2
      fi
      exit 6
      ;;
    404)
      echo "gw-agent-projects: 서버가 맡을 프로젝트 조회를 모릅니다(HTTP 404, $api) — Works 를 새 버전으로 올리세요" >&2
      exit 5
      ;;
    000 | '')
      echo "gw-agent-projects: 서버에 닿지 못했습니다($api) — 주소·네트워크를 확인하세요(운영이 아니면 GENIA_WORKS_API_URL)" >&2
      exit 5
      ;;
    *)
      echo "gw-agent-projects: 프로젝트 목록을 읽지 못했습니다(HTTP $code, $api)" >&2
      exit 5
      ;;
  esac
}

if [ -z "$assigned" ]; then
  fetch "$api/projects?page=$page&size=100"
  printf '%s\n' "$GW_BODY"
  exit 0
fi

# --assigned — 서버가 거른 목록을 한 번에 받는다. 응답은 서버가 준 데이터일 뿐이라 jq 로만 읽는다(셸이 풀어 쓰지 않는다).
command -v jq >/dev/null 2>&1 || {
  echo "gw-agent-projects: jq 가 없습니다 — 프로젝트 목록을 거르려면 jq 가 필요합니다(brew install jq 또는 apt install jq)" >&2
  exit 7
}
fetch "$api/agent-runtime/me/projects"
lines=$(printf '%s' "$GW_BODY" | jq -r '.[] | [(.projectKey // ""), (.repositoryUrl // ""), (.repositoryBranch // "")] | @tsv' 2>/dev/null) || {
  echo "gw-agent-projects: 서버 응답을 JSON 으로 읽지 못했습니다($api)" >&2
  exit 5
}
# 서버가 이미 거르지만 키는 폴더·칸 이름이 되므로 여기서도 형식을 확인하고, 저장소 주소가 빈 줄은 버린다.
tab=$(printf '\t')
all=""
while IFS="$tab" read -r k u b; do
  gw_valid_project_key "$k" || continue
  [ -n "$u" ] || continue
  all="$all$k$tab$u$tab$b
"
done <<LIST_EOF
$lines
LIST_EOF
printf '%s' "$all"
