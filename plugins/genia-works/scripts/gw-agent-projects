#!/bin/sh
# gw-agent-projects <AI 이름> [페이지] — 등록한 AI 키로 그 AI 에게 보이는 프로젝트 목록 한 페이지(GET /projects, 100개씩)를 JSON 그대로 낸다(WP-1046).
# start-agent 가 이 세션의 신원을 바꾸지 않고 고른 AI 가 맡은 프로젝트(viewerRole·repositoryUrl)를 읽는 데 쓴다.
# 응답은 { content, page, size, totalElements, totalPages } — 다음 페이지는 page+1 < totalPages 일 때 부른다.
#
# gw-agent-projects --assigned <AI 이름> — 「이 AI 가 맡을 프로젝트」를 한곳에서 고른다(WP-1265): 모든 페이지를 돌며 아래 셋을 모두 지키는 것만
# 「키<탭>저장소 주소<탭>브랜치」(브랜치는 없으면 빈 칸) 한 줄씩 낸다. 프로젝트가 없어도 0(빈 출력).
#   · viewerRole 이 있다 — 실제 멤버(viewerIsMember 는 관리자면 멤버가 아니어도 true 라 쓰지 않는다)
#   · repositoryUrl 이 있다 — 「연결된 저장소」가 없으면 코드 작업 대상이 아니다
#   · 키가 폴더·tmux 칸 이름이 되므로 gw_valid_project_key 와 같은 규칙(^[A-Za-z0-9_-]+$)을 지킨다
# start-agent 스킬과 작업 공간 이미지 엔트리포인트(list_projects)가 이 기준을 따로 갖지 않고 이것을 부른다. 실패 코드는 위와 같고,
# 한 가지 더: 7 jq 없음(JSON 을 거르는 데 쓴다). 서버 응답이 JSON 이 아니면 5.
# 실패는 「gw-agent-projects: …」 한 줄을 표준 오류로 내고 끝낸다:
#   1 키 없음·키 파일 깨짐 · 4 키 거절(401) · 5 서버 오류·닿지 못함 · 6 권한 없음(403 — 키는 맞다)
# 키는 명령줄 인자로 넘기지 않고(ps 에 보인다) 표준 입력으로 curl 설정에 넣으며, 어디에도 출력하지 않는다.
# 서버 주소: GENIA_WORKS_API_URL(예: http://localhost:6160/api/v1), 없으면 운영 주소(gw_api_url).
here=$(cd "$(dirname "$0")" && pwd)
. "$here/gw-lib.sh"

assigned=""
if [ "${1:-}" = "--assigned" ]; then
  assigned=1
  shift
fi
name=${1:-}
page=${2:-0}
if [ -z "$name" ] || { [ -n "$assigned" ] && [ $# -gt 1 ]; }; then
  echo "사용: gw-agent-projects <AI 이름> [페이지] | gw-agent-projects --assigned <AI 이름>" >&2
  exit 2
fi
[ -z "$assigned" ] || page=0
case "$page" in
  '' | *[!0-9]*)
    echo "gw-agent-projects: 페이지는 0 이상 정수여야 합니다: $page" >&2
    exit 2
    ;;
esac
api=$(gw_api_url)

# 목록(gw-keys list)에는 파일만 있으면 보이므로, 파일은 있는데 키 형식이 아니면(2) 「없음」과 나눠 알린다.
key=$(gw_read_key "$name")
case $? in
  0) ;;
  2)
    echo "gw-agent-projects: $name 키 파일이 키 형식이 아닙니다 — /genia-works:login 에서 그 AI 의 키를 바꾸세요" >&2
    exit 1
    ;;
  *)
    echo "gw-agent-projects: $name 키가 이 컴퓨터에 없습니다 — /genia-works:login 으로 넣으세요" >&2
    exit 1
    ;;
esac

# 한 페이지를 읽어 본문을 GW_BODY 에 둔다. 닿지 못하면 상태 코드 000(또는 빈 값). 실패는 여기서 알리고 끝낸다(종료 코드는 위).
fetch_page() {
  gw_api_request "$key" 10 30 "$api/projects?page=$1&size=100"
  code=$GW_CODE
  case $code in
    200) return 0 ;;
    401)
      echo "gw-agent-projects: $name 키가 거절됐습니다(HTTP 401) — 관리자 › 에이전트에서 다시 발급해 /genia-works:login 으로 바꾸세요" >&2
      exit 4
      ;;
    403)
      echo "gw-agent-projects: $name 에게 프로젝트를 볼 권한이 없습니다(HTTP 403) — 관리자에게 그 AI 의 역할을 확인하세요" >&2
      exit 6
      ;;
    000 | '')
      echo "gw-agent-projects: 서버에 닿지 못했습니다($api) — 주소·네트워크를 확인하세요(운영이 아니면 GENIA_WORKS_API_URL)" >&2
      exit 5
      ;;
    *)
      echo "gw-agent-projects: 프로젝트 목록을 읽지 못했습니다(HTTP $code, $api)" >&2
      exit 5
      ;;
  esac
}

if [ -z "$assigned" ]; then
  fetch_page "$page"
  printf '%s\n' "$GW_BODY"
  exit 0
fi

# --assigned — 모든 페이지를 돌며 거른다. 응답은 서버가 준 데이터일 뿐이라 jq 로만 읽는다(셸이 풀어 쓰지 않는다).
command -v jq >/dev/null 2>&1 || {
  echo "gw-agent-projects: jq 가 없습니다 — 프로젝트 목록을 거르려면 jq 가 필요합니다(brew install jq 또는 apt install jq)" >&2
  exit 7
}
# 줄은 끝까지 모았다가 한 번에 낸다 — 중간 페이지가 실패하면 앞 페이지의 줄이 반쯤 나가지 않는다(실패하면 표준 출력은 비어 있다).
all=""
while :; do
  fetch_page "$page"
  # jq 는 멤버·저장소 조건만 보고, 키 형식은 gw_valid_project_key(gw-lib.sh)로 아래에서 거른다 — 정규식을 두 곳에 적지 않는다.
  lines=$(printf '%s' "$GW_BODY" | jq -r '.content[]? | select(.viewerRole != null and (.repositoryUrl // "") != "")
                                          | [(.key // ""), .repositoryUrl, (.repositoryBranch // "")] | @tsv' 2>/dev/null) || {
    echo "gw-agent-projects: 서버 응답을 JSON 으로 읽지 못했습니다($api)" >&2
    exit 5
  }
  tab=$(printf '\t')
  while IFS="$tab" read -r k u b; do
    gw_valid_project_key "$k" || continue
    all="$all$k$tab$u$tab$b
"
  done <<LIST_EOF
$lines
LIST_EOF
  total=$(printf '%s' "$GW_BODY" | jq -r '.totalPages // 0' 2>/dev/null)
  case "$total" in '' | *[!0-9]*) total=0 ;; esac
  page=$((page + 1))
  [ "$page" -lt "$total" ] || break
done
printf '%s' "$all"
