#!/bin/sh
# work-loop 잠금 — 한 저장소(MAIN)에는 work-loop 하나만 돈다(WP-376).
#
#   loop-lock acquire <MAIN>   # 잡으면 "ok", 다른 work-loop 가 쥐고 있으면 "held <pid>"
#   loop-lock release <MAIN>   # 내 잠금이면 지운다(남의 잠금은 그대로) — "ok"
#
# 종료 코드: 0 = ok · 1 = held(다른 살아 있는 claude 가 쥠) · 2 = 사용법 오류·내 claude 를 못 읽음·파일을 못 씀
#
# 잠금 파일 MAIN/.work-loop/state/loop.lock 한 줄 = 쥔 claude 의 세션 키 "<pid>-<시작 시각>"(gw_proc_key).
# - pid 는 이 명령을 부른 claude 세션(가장 가까운 claude 조상) — Bash 도구의 셸은 호출마다 끝나서 쓰지 않는다.
# - 시작 시각을 함께 보는 까닭: pid 는 다시 쓰이므로, 잠금을 남긴 프로세스가 죽은 뒤 무관한 claude 세션이
#   같은 pid 를 받으면 pid 만으로는 살아 있는 잠금으로 보여 영원히 막힌다.
# - 넘겨받기: 파일이 없거나, 적힌 pid 가 죽었거나 claude 가 아니거나, 그 pid 의 지금 시작 시각이 적힌 것과 다르면
#   (pid 재사용 — 예전 모양의 줄도 여기에 걸린다) 내 키로 새로 쓴다. 적힌 키가 내 것이면 그대로 진행한다.
# - /loop 의 반복마다 같은 세션이 다시 잡으므로 work-loop 는 release 를 부르지 않는다(세션이 끝나면 넘겨받기로 풀린다).
here=$(cd "$(dirname "$0")" && pwd)
. "$here/gw-lib.sh"

usage() {
  echo "사용법: loop-lock acquire|release <MAIN>" >&2
  exit 2
}

[ $# -eq 2 ] && [ -n "$2" ] || usage
_ll_lock="$2/.work-loop/state/loop.lock"

# 내 claude — 조상에서 못 찾으면 부른 셸의 부모(예전 스킬이 쓰던 Bash 셸의 $PPID 와 같은 프로세스)로 대신한다.
_ll_me=$(gw_claude_pid) || _ll_me=$(ps -o ppid= -p "${GW_START_PID:-$PPID}" 2>/dev/null | tr -d ' ')
_ll_mykey=$(gw_proc_key "$_ll_me" 2>/dev/null) || { echo "이 claude 세션의 시작 시각을 읽지 못했습니다" >&2; exit 2; }

# 잠금 파일의 첫 줄(없으면 빈 값)
_ll_held=""
[ -f "$_ll_lock" ] && { IFS= read -r _ll_held < "$_ll_lock" || true; }

case "$1" in
  acquire)
    if [ -n "$_ll_held" ] && [ "$_ll_held" != "$_ll_mykey" ]; then
      _ll_pid=${_ll_held%%-*}
      # 다른 살아 있는 claude 이고 시작 시각도 맞으면 그 세션의 잠금이다.
      case "$_ll_pid" in
        '' | *[!0-9]*) ;;
        *)
          if gw_pid_alive "$_ll_pid" && gw_is_claude_proc "$_ll_pid" \
            && [ "$(gw_proc_key "$_ll_pid" 2>/dev/null)" = "$_ll_held" ]; then
            echo "held $_ll_pid"
            exit 1
          fi
          ;;
      esac
    fi
    if [ "$_ll_held" != "$_ll_mykey" ]; then
      mkdir -p "$(dirname "$_ll_lock")" && gw_write_atomic "$_ll_lock" "$_ll_mykey" \
        || { echo "잠금 파일을 쓰지 못했습니다: $_ll_lock" >&2; exit 2; }
    fi
    echo ok
    ;;
  release)
    [ "$_ll_held" = "$_ll_mykey" ] && rm -f "$_ll_lock"
    echo ok
    ;;
  *) usage ;;
esac
