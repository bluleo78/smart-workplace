#!/bin/sh
# gw-clear-mark — work-loop 칸이 실행 사이에 대화를 비워도 되는 때(「비워도 됨」 표시)를 적고 지우는 작은 도구(WP-1714).
# 칸의 대화를 비우는 것(/clear)은 일을 잃지 않을 때만 해야 한다 — 그래서 work-loop 이 한 회차를 끝까지 마친 표시(clear-ok)를 남기고,
# 칸 뒤의 모드(mod)·감시가 그 표시와 사람 글 기록(human)을 보고 비운다. 표시는 에포크 초(date +%s)를 파일 내용에 써서 나이를 잰다(stat 은
# BSD·GNU 가 달라 쓰지 않는다). 상태 파일은 모두 <AI 폴더>/state/ 에 둔다.
#
#   gw-clear-mark set <프로젝트 키> <idle|timeout|error>
#     <AI 폴더>/state/clear-ok-<키> 에 「<지금 초> <까닭>」 한 줄을 쓴다. 깨우는 방식(gw-wake-mode)이 pane 이고 GENIA_WORKS_AGENT_DIR 가
#     AI 폴더일 때만 한다 — 사람이 띄운 칸·실행기 칸은 비우지 않는다. 까닭이 세 값이 아니면 idle. 늘 종료 0, 출력 없음.
#   gw-clear-mark seen <AI 폴더> <칸 id> <loop|notice|human>
#     칸에 입력이 들어갔음을 알린다(mod 가 부른다). 칸 사용자 옵션 @gw_key 로 그 칸의 프로젝트 키를 찾아 clear-ok-<키> 를 지운다 —
#     새 입력이 있었으니 앞의 「비워도 됨」은 낡았다. human(사람이 친 글)이면 human-<키> 에 지금 초를 써 한동안 비우지 않게 한다.
#     키를 못 찾으면(빈 값·tmux 실패·키 모양 아님) 어느 칸인지 모르므로 그 AI 의 clear-ok-* 를 모두 지우고, human 이면 human-all 을 쓴다.
#     늘 종료 0, 출력 없음. GW_TMUX 는 테스트 전용 훅(격리한 tmux 서버).
#   gw-clear-mark miss <프로젝트 키> <이슈 키>
#     비운 뒤 이어 하기(resume)가 일을 못 찾았음을 <AI 폴더>/state/events.log 에 「clear <키> resume-miss <이슈 키>」 한 줄로 남긴다.
#     set 과 같은 조건(pane 방식·AI 폴더)일 때만. 이슈 키는 서버 이슈 키 모양만 받는다.
# 키·토큰은 다루지 않는다 — 인자·로그에 남는 것은 프로젝트 키·이슈 키뿐이다.
here=$(cd "$(dirname "$0")" && pwd)
. "$here/gw-lib.sh"
tmux=${GW_TMUX:-tmux}

# 표시를 쓸 수 있는 칸이면 그 AI 폴더의 state 경로를 낸다 — pane 방식이고 GENIA_WORKS_AGENT_DIR 가 AI 폴더일 때만(아니면 1).
clear_state_dir() {
  [ "$("$here/gw-wake-mode")" = pane ] || return 1
  [ -n "${GENIA_WORKS_AGENT_DIR:-}" ] || return 1
  _cm_dir=$(gw_ai_dir "$GENIA_WORKS_AGENT_DIR") || return 1
  printf '%s/state\n' "$_cm_dir"
}

case "${1:-}" in
  set)
    gw_valid_project_key "${2:-}" && state=$(clear_state_dir) || exit 0
    case "${3:-}" in idle | timeout | error) why=$3 ;; *) why=idle ;; esac
    mkdir -p "$state" 2>/dev/null && printf '%s %s\n' "$(date +%s)" "$why" > "$state/clear-ok-$2" 2>/dev/null
    ;;
  seen)
    aidir=$(gw_ai_dir "${2:-}") || exit 0
    state="$aidir/state"
    case "${4:-}" in loop | notice | human) kind=$4 ;; *) exit 0 ;; esac
    # 칸의 프로젝트 키 — tmux 를 못 읽거나 키 모양이 아니면 비워 둔다(그때는 그 AI 의 모든 표시를 다룬다).
    # 칸 id 가 %<숫자> 모양이 아니면 tmux 에 묻지 않는다(그때도 모든 표시를 다룬다).
    key=
    case "${3:-}" in
      %[0-9]*) case "${3#%}" in *[!0-9]*) ;; *) key=$("$tmux" display -p -t "$3" '#{@gw_key}' 2>/dev/null) ;; esac ;;
    esac
    gw_valid_project_key "$key" || key=
    mkdir -p "$state" 2>/dev/null || exit 0
    if [ -n "$key" ]; then
      rm -f "$state/clear-ok-$key"
      [ "$kind" = human ] && date +%s > "$state/human-$key"
    else
      rm -f "$state"/clear-ok-*
      [ "$kind" = human ] && date +%s > "$state/human-all"
    fi
    ;;
  miss)
    gw_valid_project_key "${2:-}" && gw_valid_issue_key "${3:-}" && state=$(clear_state_dir) || exit 0
    mkdir -p "$state" 2>/dev/null && printf 'clear %s resume-miss %s\n' "$2" "$3" >> "$state/events.log" 2>/dev/null
    ;;
esac
exit 0
