#!/bin/sh
# agent-home <AI 폴더> <명령> … — start-agent 가 만든 AI 폴더(<홈>/<AI 이름>)의 설정과 「새 프로젝트 확인」을 다룬다(WP-1053).
#   get queue          — 저장한 대기열 라벨을 낸다(빈 값도 값이다 — 「가져오지 않기」). 저장한 적이 없으면 아무것도 내지 않고 1.
#   set queue <라벨>   — 대기열 라벨을 저장한다(빈 값 = 가져오지 않기). 큰따옴표 "·역슬래시 \ 는 work-loop 인자(--queue "…")를 깨뜨려 거절한다.
#   due                — 새 프로젝트 확인을 할 때면 0, 아니면 1. work-loop 가 깨어날 때마다 부른다 — 같은 AI 의 칸 여럿이 함께 깨어나도
#                        5분 구간마다 처음 부른 하나만 0 이다(mkdir 은 한 쪽만 성공). AI 폴더가 비었으면(start-agent 로 띄운 칸이 아님) 조용히 1.
#   missing <키>…      — 받은 프로젝트 키(그 AI 가 지금 맡은 것 전부) 중 tmux 칸이 없는 키를 한 줄씩 낸다. AI 의 tmux 세션이 없으면 3.
# 설정은 <AI 폴더>/agent.conf(한 줄에 「이름=값」), 기록은 <AI 폴더>/state/ 에 둔다.
here=$(cd "$(dirname "$0")" && pwd)
. "$here/gw-lib.sh"

aidir=${1:-}
cmd=${2:-}
[ -z "$aidir" ] && [ "$cmd" = due ] && exit 1
if [ -z "$aidir" ] || [ -z "$cmd" ]; then
  echo "사용: agent-home <AI 폴더> get|set|due|missing …" >&2
  exit 2
fi
# AI 폴더 이름은 AI 이름(키 이름과 같은 규칙)이고 tmux 세션 이름이 된다.
aidir=$(gw_ai_dir "$aidir") || { echo "AI 폴더가 아닙니다: ${1:-}" >&2; exit 2; }
shift 2
conf="$aidir/agent.conf"
state="$aidir/state"

case "$cmd" in
  get | set)
    case "${1:-}" in queue) ;; *) echo "모르는 이름: ${1:-}" >&2; exit 2 ;; esac
    ;;
esac

case "$cmd" in
  get)
    line=$(grep -m1 "^$1=" "$conf" 2>/dev/null) || exit 1
    printf '%s\n' "${line#*=}"
    ;;
  set)
    [ $# -eq 2 ] || { echo "사용: agent-home <AI 폴더> set <이름> <값>" >&2; exit 2; }
    case "$2" in *'
'* | *'"'* | *\\*) echo "값에 줄바꿈·큰따옴표(\")·역슬래시(\\)를 넣을 수 없습니다" >&2; exit 2 ;; esac
    rest=$(grep -v "^$1=" "$conf" 2>/dev/null)
    gw_write_atomic "$conf" "${rest:+$rest
}$1=$2"
    ;;
  due)
    mkdir -p "$state"
    slot="$state/checked-$(($(date +%s) / 300))"
    mkdir "$slot" 2>/dev/null || exit 1
    # 지난 구간 표시는 지운다(이번 것만 남긴다).
    for d in "$state"/checked-*; do
      [ "$d" = "$slot" ] || rmdir "$d" 2>/dev/null
    done
    ;;
  missing)
    # 칸 키는 agent-window 가 다는 것이라 그것으로 읽는다(예전 구성의 프로젝트 창은 창 이름 — 그 프로젝트도 돌고 있는 것이다).
    panes=$("$here/agent-window" --keys "$(basename "$aidir")") || exit 3
    nl='
'
    for k in "$@"; do
      # 키로 쓸 수 없는 값은 건너뛴다(띄우지 못하는 키를 매번 내지 않게).
      gw_valid_project_key "$k" || { echo "이상한 프로젝트 키: $k" >&2; continue; }
      case "$nl$panes$nl" in *"$nl$k$nl"*) ;; *) printf '%s\n' "$k" ;; esac
    done
    ;;
  *)
    echo "모르는 명령: $cmd" >&2
    exit 2
    ;;
esac
