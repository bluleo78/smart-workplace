#!/bin/sh
# 테스트용 tmux — FAKE_TMUX_STATE 에 「세션:창」 줄로 상태를 두고, 받은 인자를 FAKE_TMUX_LOG 에 한 줄(탭 구분)로 남긴다.
printf '%s' "$1" >> "$FAKE_TMUX_LOG"; for a in "$@"; do [ "$a" = "$1" ] || printf '\t%s' "$a" >> "$FAKE_TMUX_LOG"; done; echo >> "$FAKE_TMUX_LOG"
touch "$FAKE_TMUX_STATE"
cmd=$1; shift
target=""; name=""; session=""
while [ $# -gt 0 ]; do
  case "$1" in
    -t) target=$2; shift 2 ;;
    -s) session=$2; shift 2 ;;
    -n) name=$2; shift 2 ;;
    -c | -F) shift 2 ;;
    -d) shift ;;
    *) break ;;
  esac
done
target=${target#=}; target=${target%:}
case "$cmd" in
  has-session) grep -q "^$target:" "$FAKE_TMUX_STATE" ;;
  list-windows) grep "^$target:" "$FAKE_TMUX_STATE" | cut -d: -f2- ;;
  new-session) echo "$session:$name" >> "$FAKE_TMUX_STATE" ;;
  new-window) echo "$target:$name" >> "$FAKE_TMUX_STATE" ;;
  *) exit 1 ;;
esac
