{
  "schemaVersion": 1,
  "platform": "linux/amd64",
  "images": [
    {
      "id": "api",
      "repository": "docker.io/iacloudops/genia-works-api",
      "context": "apps/workplace-api",
      "dockerfile": "apps/workplace-api/Dockerfile",
      "paths": [
        "apps/workplace-api/"
      ]
    },
    {
      "id": "ai-agent",
      "repository": "docker.io/iacloudops/genia-works-ai-agent",
      "context": ".",
      "dockerfile": "apps/workplace-ai-agent/Dockerfile",
      "paths": [
        "apps/workplace-ai-agent/",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "package.json",
        ".npmrc",
        "patches/",
        ".dockerignore"
      ]
    },
    {
      "id": "worker",
      "repository": "docker.io/iacloudops/genia-works-worker",
      "context": "apps/workplace-worker",
      "dockerfile": "apps/workplace-worker/Dockerfile",
      "paths": [
        "apps/workplace-worker/"
      ]
    },
    {
      "id": "converter",
      "repository": "docker.io/iacloudops/genia-works-converter",
      "context": "apps/workplace-converter",
      "dockerfile": "apps/workplace-converter/Dockerfile",
      "paths": [
        "apps/workplace-converter/"
      ]
    },
    {
      "id": "mcp",
      "repository": "docker.io/iacloudops/genia-works-mcp",
      "context": ".",
      "dockerfile": "apps/workplace-mcp/Dockerfile",
      "paths": [
        "apps/workplace-mcp/",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "package.json",
        ".npmrc",
        "patches/",
        ".dockerignore"
      ]
    },
    {
      "id": "collab",
      "repository": "docker.io/iacloudops/genia-works-collab",
      "context": ".",
      "dockerfile": "apps/workplace-collab/Dockerfile",
      "paths": [
        "apps/workplace-collab/",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "package.json",
        ".npmrc",
        "patches/",
        ".dockerignore"
      ]
    },
    {
      "id": "web",
      "repository": "docker.io/iacloudops/genia-works-web",
      "context": ".",
      "dockerfile": "apps/workplace-web/Dockerfile",
      "buildArgs": {
        "VITE_MCP_URL": ""
      },
      "paths": [
        "apps/workplace-web/",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "package.json",
        ".npmrc",
        "patches/",
        ".dockerignore",
        "scripts/vite-app-version.mjs",
        "scripts/vite-app-version.d.mts",
        "releases/"
      ]
    },
    {
      "id": "admin",
      "repository": "docker.io/iacloudops/genia-works-admin",
      "context": ".",
      "dockerfile": "apps/workplace-admin/Dockerfile",
      "paths": [
        "apps/workplace-admin/",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "package.json",
        ".npmrc",
        "patches/",
        ".dockerignore",
        "scripts/vite-app-version.mjs",
        "scripts/vite-app-version.d.mts"
      ]
    },
    {
      "id": "db",
      "repository": "docker.io/iacloudops/genia-works-db",
      "context": "db",
      "dockerfile": "db/Dockerfile",
      "paths": [
        "db/"
      ]
    },
    {
      "id": "agent-runner",
      "repository": "docker.io/iacloudops/genia-works-agent-runner",
      "context": ".",
      "dockerfile": "apps/workplace-agent-runner/Dockerfile",
      "helm": false,
      "paths": [
        "apps/workplace-agent-runner/",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "package.json",
        ".npmrc",
        "patches/",
        ".dockerignore"
      ]
    },
    {
      "id": "agent-claude-code",
      "repository": "docker.io/iacloudops/genia-works-agent-claude-code",
      "context": "apps/workplace-agent-claude-code",
      "dockerfile": "apps/workplace-agent-claude-code/Dockerfile",
      "helm": false,
      "paths": [
        "apps/workplace-agent-claude-code/"
      ]
    },
    {
      "id": "agent-genia-code",
      "repository": "docker.io/iacloudops/genia-works-agent-genia-code",
      "context": ".",
      "dockerfile": "apps/workplace-agent-genia-code/Dockerfile",
      "helm": false,
      "paths": [
        "apps/workplace-agent-genia-code/",
        "apps/workplace-agent-claude-code/bin/lib.sh",
        "apps/workplace-agent-claude-code/bin/agent-screen",
        "apps/workplace-agent-claude-code/plugins.lock",
        "plugins/genia-works/",
        ".dockerignore"
      ]
    },
    {
      "id": "agent-codex",
      "repository": "docker.io/iacloudops/genia-works-agent-codex",
      "context": ".",
      "dockerfile": "apps/workplace-agent-codex/Dockerfile",
      "helm": false,
      "paths": [
        "apps/workplace-agent-codex/",
        "apps/workplace-agent-claude-code/bin/lib.sh",
        "apps/workplace-agent-claude-code/bin/agent-screen",
        "apps/workplace-agent-claude-code/plugins.lock",
        "apps/workplace-agent-genia-code/skills/",
        "plugins/genia-works/",
        ".dockerignore"
      ]
    },
    {
      "id": "agent-opencode",
      "repository": "docker.io/iacloudops/genia-works-agent-opencode",
      "context": ".",
      "dockerfile": "apps/workplace-agent-opencode/Dockerfile",
      "helm": false,
      "paths": [
        "apps/workplace-agent-opencode/",
        "apps/workplace-agent-claude-code/bin/lib.sh",
        "apps/workplace-agent-claude-code/bin/agent-screen",
        "apps/workplace-agent-claude-code/plugins.lock",
        "apps/workplace-agent-genia-code/skills/",
        "plugins/genia-works/",
        ".dockerignore"
      ]
    }
  ]
}
