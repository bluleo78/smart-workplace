      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "commentId": {
          "description": "Issue comment: its id as read from the issue detail comments",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "emoji": {
          "description": "Unicode emoji such as 👍; to remove, the exact string shown in reactions",
          "maxLength": 32,
          "minLength": 1,
          "type": "string",
        },
        "issueKey": {
          "description": "Issue comment: issue key, together with commentId",
          "minLength": 1,
          "type": "string",
        },
        "messageId": {
          "description": "Chat message: its id as read from channel or thread messages",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "reacted": {
          "description": "true adds my reaction, false removes it",
          "type": "boolean",
        },
      },
      "required": [
        "emoji",
        "reacted",
      ],
      "type": "object",
    },
  },
