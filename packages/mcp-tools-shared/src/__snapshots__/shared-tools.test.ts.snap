    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "addAttendees": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string",
              },
              "type": "array",
            },
            {
              "type": "null",
            },
          ],
        },
        "allDay": {
          "anyOf": [
            {
              "type": "boolean",
