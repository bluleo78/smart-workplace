  {
    "name": "list_issues",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "assignee": {
          "description": "CSV of "me", "null" (unassigned), "any" or usernames; default "me" unless reporter/watching/parent is set",
          "type": "string",
        },
        "blocked": {
          "description": "Only issues with an unfinished blocker",
          "type": "boolean",
        },
        "closedFrom": {
          "type": "string",
        },
        "closedTo": {
          "type": "string",
        },
        "createdFrom": {
          "type": "string",
        },
        "createdTo": {
          "type": "string",
        },
        "cursor": {
          "type": "string",
        },
        "cycle": {
          "description": "CSV, any match: cycle (사이클) names, "active", "none", "backlog" (no active/planned cycle); names and "active" need projectKey",
          "type": "string",
        },
        "dueFrom": {
          "type": "string",
        },
        "dueTo": {
          "type": "string",
        },
        "field": {
          "description": ""name=value" custom field match (not MULTI_SELECT); needs projectKey",
          "type": "string",
        },
        "label": {
          "description": "Label names CSV; all must match",
          "type": "string",
        },
        "milestone": {
          "description": "Milestone names CSV, any match; needs projectKey",
          "type": "string",
        },
        "parent": {
          "description": "Only children of this issue key",
          "type": "string",
        },
        "pendingForMe": {
          "description": "Only issues with chat posts by others after my last",
          "type": "boolean",
        },
        "priority": {
          "items": {
            "enum": [
              "LOW",
              "MID",
              "HIGH",
            ],
            "type": "string",
          },
          "type": "array",
        },
        "projectKey": {
          "description": "Omit for all my projects",
          "type": "string",
        },
        "q": {
          "description": "Substring of title or body",
          "type": "string",
        },
        "reporter": {
          "description": "CSV: "me" or usernames",
          "type": "string",
        },
        "size": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "status": {
          "description": "CSV: TODO,IN_PROGRESS,DONE,CANCELED or status names, not both",
          "type": "string",
        },
        "topLevel": {
          "description": "Only issues without a parent",
          "type": "boolean",
        },
        "type": {
          "description": "Type names CSV; any matches",
          "type": "string",
        },
        "watching": {
          "description": "Only issues I watch",
          "type": "boolean",
        },
      },
      "type": "object",
    },
  },
