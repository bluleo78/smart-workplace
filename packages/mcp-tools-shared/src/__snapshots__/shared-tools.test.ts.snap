              "minLength": 1,
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "null clears",
        },
        "parent": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "Parent issue key, same project; null clears",
        },
        "priority": {
          "enum": [
            "LOW",
            "MID",
            "HIGH",
          ],
          "type": "string",
        },
        "startDate": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
        },
        "status": {
          "description": "TODO/IN_PROGRESS/DONE/CANCELED or a status name",
          "minLength": 1,
          "type": "string",
        },
        "title": {
          "maxLength": 200,
          "type": "string",
        },
        "type": {
          "type": "string",
        },
      },
      "required": [
        "issueKey",
      ],
      "type": "object",
    },
  },
