            "CANCELED",
            "REJECTED",
          ],
          "type": "string",
        },
        "stepsDone": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "stepsTotal": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer",
        },
