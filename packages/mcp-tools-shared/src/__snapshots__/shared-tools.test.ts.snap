  {
    "name": "list_issues",
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "assignee": {
          "description": "담당자 CSV: "me"(나) | "null"(담당 없음) | username | "any"(담당자 무관 — 프로젝트 전체 이슈). 표시 이름이 아닌 username. assignee·reporter 모두 생략 시 "me"",
          "type": "string",
        },
        "blocked": {
          "type": "boolean",
        },
        "closedFrom": {
          "description": "종료일(DONE·CANCELED 진입) 하한 yyyy-MM-dd, Asia/Seoul 기준",
          "type": "string",
        },
        "closedTo": {
          "description": "종료일 상한 yyyy-MM-dd(포함), Asia/Seoul 기준",
          "type": "string",
        },
        "createdFrom": {
          "description": "생성일 하한 yyyy-MM-dd, Asia/Seoul 기준",
          "type": "string",
        },
        "createdTo": {
          "description": "생성일 상한 yyyy-MM-dd(포함), Asia/Seoul 기준",
          "type": "string",
        },
        "cursor": {
          "description": "다음 페이지 커서 — 이전 호출 결과의 nextCursor 를 그대로(필터·size 는 같게)",
          "type": "string",
        },
        "cycle": {
          "description": "사이클 CSV(하나라도 일치하면 매칭, OR): 사이클 이름 | "active"(진행 중 사이클) | "none"(사이클이 하나도 할당되지 않은 이슈) | "backlog"(진행 중·예정 사이클 밖 — 완료 사이클에만 남은 이슈 포함). "사이클 미할당"은 none, "백로그"는 backlog. 이름·active 는 projectKey 필요",
          "type": "string",
        },
        "dueFrom": {
          "description": "마감일 하한 yyyy-MM-dd(생성일·종료일 아님)",
          "type": "string",
        },
        "dueTo": {
          "description": "마감일 상한 yyyy-MM-dd(생성일·종료일 아님)",
          "type": "string",
        },
        "label": {
          "description": "라벨 이름 CSV(예: "버그,문서"). 여러 개면 모두 붙은 이슈만(AND). 대소문자 무시",
          "type": "string",
        },
        "priority": {
          "items": {
            "enum": [
              "LOW",
              "MID",
              "HIGH",
            ],
            "type": "string",
          },
          "type": "array",
        },
        "projectKey": {
          "description": "특정 프로젝트로 한정(예: "WP"). 생략 시 내가 속한 모든 프로젝트",
          "type": "string",
        },
        "q": {
          "type": "string",
        },
        "reporter": {
          "description": "작성자 CSV: "me" | username",
          "type": "string",
        },
        "size": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "status": {
          "description": "상태 CSV: TODO,IN_PROGRESS,DONE,CANCELED",
          "type": "string",
        },
        "topLevel": {
          "type": "boolean",
        },
        "type": {
          "description": "유형 이름 CSV(예: "BUG,STORY"). 하나라도 일치하면 매칭(OR)",
          "type": "string",
        },
      },
      "type": "object",
    },
  },
