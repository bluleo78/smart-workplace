          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "dueDate": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
        },
        "fields": {
          "additionalProperties": {},
          "description": "Custom field values by name (string[] for MULTI_SELECT, null clears)",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "fileIds": {
          "description": "Staged files from upload_file to attach",
