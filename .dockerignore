# Version control
.git/
.gitignore

# Build outputs
**/build/
**/dist/
**/.gradle/

# Dependencies
**/node_modules/

# IDE
.idea/
.vscode/
*.iml
*.swp

# Environment
.env
.env.local
.env.*.local

# Claude / OMC
.claude/
.omc/

# Turborepo
.turbo/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Snapshots
snapshots/

# Test files
**/*.test.ts
**/*.spec.ts
# 컴포넌트 테스트(RTL, WP-413)도 뺀다 — src/test/ 헬퍼가 빠진 채 남으면 웹 빌드의 tsc -b 가 실패한다
**/*.test.tsx
**/*.spec.tsx
**/src/test/

# Java artifacts
**/*.class
**/*.jar
**/*.war
**/.gradle/

# 노트 동기화 서버(WP-288) — 로컬 비밀(.env*)과 드라이런 결과(out/, 실제 노트 내용)가 이미지에 들어가지 않게.
apps/workplace-collab/.env
apps/workplace-collab/.env.local
apps/workplace-collab/out/
